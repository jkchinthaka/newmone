{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git stash list:*)",
      "Bash(git worktree list:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run test:*)",
      "Bash(npx tsc:*)",
      "Bash(npx jest:*)",
      "Bash(npx playwright test:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --mirror:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push origin +*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git clean -xfd:*)",
      "Bash(git stash pop:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear:*)",
      "Bash(git filter-branch:*)",
      "Bash(git filter-repo:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)",
      "PowerShell(git push --force-with-lease:*)",
      "PowerShell(git push origin main:*)",
      "PowerShell(git reset --hard:*)",
      "PowerShell(git clean -f:*)",
      "PowerShell(git clean -fd:*)",
      "PowerShell(git clean -fdx:*)",
      "PowerShell(git stash pop:*)",
      "PowerShell(git stash drop:*)",
      "PowerShell(git stash clear:*)",
      "Bash(npm run db:push:*)",
      "Read(./.env)",
      "Read(./maintainpro/.env)",
      "Read(./maintainpro/.env.e2e)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",
      "Read(./**/*.pem)",
      "Read(./**/*.pfx)"
    ]
  }
}
