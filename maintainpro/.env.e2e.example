# Disposable E2E fixture only. Copy to .env.e2e locally/CI.
# NEVER use production credentials. NEVER commit .env.e2e with secrets.

NODE_ENV=test
E2E_TEST_MODE=true
E2E_RUN_ID=local-dev
COMPOSE_PROJECT_NAME=maintainpro-e2e-local
E2E_HTTP_PORT=18080
E2E_MSSQL_PORT=14333
E2E_MONGO_PORT=27019
E2E_BASE_URL=http://127.0.0.1:18080
# Host-side migrate/seed against loopback-published E2E SQL Server
E2E_DATABASE_URL_HOST=sqlserver://127.0.0.1:14333;database=maintainpro_e2e_primary;user=sa;password=E2e_Sql_Sa_Passw0rd!;schema=dbo;encrypt=true;trustServerCertificate=true

APP_VERSION=1.2.0
APP_COMMIT_SHA=e2e0000000000000000000000000000000000001
APP_BUILD_TIMESTAMP=1970-01-01T00:00:00.000Z
APP_ENVIRONMENT=e2e

CORS_ORIGIN=http://127.0.0.1:18080
FRONTEND_URL=http://127.0.0.1:18080
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_API_ORIGIN=http://127.0.0.1:18080
NEXT_PUBLIC_USE_BFF=true
API_INTERNAL_URL=http://api:3000/api
ALLOW_INSECURE_HTTP=true
COOKIE_SECURE=false

DATABASE_PROVIDER=sqlserver
MSSQL_SA_PASSWORD=E2e_Sql_Sa_Passw0rd!
PRIMARY_DATABASE_NAME=maintainpro_e2e_primary
BACKUP_DATABASE_NAME=maintainpro_e2e_backup
DATABASE_URL=sqlserver://sqlserver:1433;database=maintainpro_e2e_primary;user=sa;password=E2e_Sql_Sa_Passw0rd!;schema=dbo;encrypt=true;trustServerCertificate=true
PRIMARY_DATABASE_URL=sqlserver://sqlserver:1433;database=maintainpro_e2e_primary;user=sa;password=E2e_Sql_Sa_Passw0rd!;schema=dbo;encrypt=true;trustServerCertificate=true
BACKUP_DATABASE_URL=
# Mongo remains migration-source / FG dependency only (not MaintainPro API primary).
MONGO_INITDB_ROOT_USERNAME=e2e_root_not_prod
MONGO_INITDB_ROOT_PASSWORD=e2e_root_password_not_for_production_use
MONGO_INITDB_DATABASE=maintainpro_e2e_auth
MONGO_APP_USERNAME=e2e_app_not_prod
MONGO_APP_PASSWORD=e2e_app_password_not_for_production_use
MONGO_DATABASE_NAME=maintainpro_e2e_primary
MONGODB_URI=mongodb://e2e_app_not_prod:e2e_app_password_not_for_production_use@mongo:27017/maintainpro_e2e_primary?authSource=maintainpro_e2e_auth&replicaSet=rs0
DATABASE_REPLICATION_ENABLED=false
DATABASE_REPLICATION_MODE=disabled
BACKUP_DATABASE_REQUIRED_FOR_READINESS=false
REDIS_REQUIRED_FOR_READINESS=false
OBJECT_STORAGE_REQUIRED_FOR_READINESS=false

REDIS_URL=redis://redis:6379
REDIS_KEY_PREFIX=e2e:

JWT_ACCESS_SECRET=e2e_jwt_access_secret_not_for_production_use_32
JWT_REFRESH_SECRET=e2e_jwt_refresh_secret_not_for_production_use
JWT_SECRET=e2e_jwt_shared_secret_not_for_production_use_only
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=e2e_minio_access_not_prod
MINIO_SECRET_KEY=e2e_minio_secret_not_for_production
MINIO_BUCKET=maintainpro-e2e-files
STORAGE_MODE=minio

NOTIFICATION_REAL_SENDS_ENABLED=false
NOTIFICATION_UAT_ENABLED=false
OPERATIONAL_ALERT_NOTIFICATION_MODE=mock
QUEUE_STARTUP_RECONCILIATION_ENABLED=true
ALLOW_MOCK_IN_PRODUCTION=false

# Disposable seed password (fixture, not production)
E2E_SEED_PASSWORD=E2eDisposablePass123!
E2E_SEED_EMAIL_DOMAIN=e2e.maintainpro.test
MAINTAINPRO_SEED_PASSWORD=E2eDisposablePass123!
