+"use client";
+import { useEffect, useState } from "react";
+import { readAccessPreview, stopAccessPreview, type AccessPreview } from "@/lib/access-preview";
+
+export function AccessPreviewBanner() {
+  const [preview, setPreview] = useState<AccessPreview | null>(null);
+  useEffect(() => { setPreview(readAccessPreview()); }, []);
+  if (!preview) return null;
+  return <div role="status" className="sticky top-0 z-[100] flex shrink-0 flex-wrap items-center justify-between gap-2 bg-amber-200 px-4 py-3 text-sm font-semibold text-amber-950">
+    <span>Preview as {preview.label} — read-only. Changes are blocked.</span>
+    <button type="button" onClick={stopAccessPreview} className="min-h-11 rounded border border-amber-800 px-3">Exit preview</button>
+  </div>;
+}
diff --git a/apps/web/lib/access-preview.ts b/apps/web/lib/access-preview.ts
new file mode 100644
index 00000000..1cc50529
--- /dev/null
+++ b/apps/web/lib/access-preview.ts
@@ -0,0 +1,21 @@
+export const PREVIEW_STORAGE_KEY = "maintainpro.access-preview.v1";
+export type AccessPreview = { userId: string; label: string };
+
+export function readAccessPreview(): AccessPreview | null {
+  if (typeof window === "undefined") return null;
+  try {
+    const value = JSON.parse(window.sessionStorage.getItem(PREVIEW_STORAGE_KEY) ?? "null");
+    return typeof value?.userId === "string" && value.userId && typeof value?.label === "string" ? value : null;
+  } catch { return null; }
+}
+
+export function startAccessPreview(userId: string, label: string) {
+  window.sessionStorage.setItem(PREVIEW_STORAGE_KEY, JSON.stringify({ userId, label }));
+  // Reload clears all caller-scoped query caches before target reads begin.
+  window.location.assign("/action-center");
+}
+
+export function stopAccessPreview() {
+  window.sessionStorage.removeItem(PREVIEW_STORAGE_KEY);
+  window.location.assign("/admin/users");
+}
