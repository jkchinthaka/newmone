# Vercel public variables
NEXT_PUBLIC_API_URL=https://your-render-api.onrender.com/api
NEXT_PUBLIC_API_TIMEOUT_MS=60000

# Backward-compatible aliases used by older builds and websocket clients.
NEXT_PUBLIC_API_BASE_URL=https://your-render-api.onrender.com/api
NEXT_PUBLIC_API_ORIGIN=https://your-render-api.onrender.com

# --- Realtime notifications (hooks/use-notifications-socket.ts) ---
# The notifications gateway is served by the API itself (socket.io namespace
# /notifications on NEXT_PUBLIC_API_ORIGIN), so the browser connects cross-origin rather
# than through the BFF. Where that origin is not reachable from the browser the socket
# cannot connect and the bell falls back to polling /notifications over the BFF — set
# this to false in those environments to stop attempting the connection (and to keep the
# browser console free of failed-handshake noise). Unset/true = realtime enabled.
# NEXT_PUBLIC_REALTIME_NOTIFICATIONS=false

# --- BFF routing (app/api/backend/[...path]/route.ts) ---
# The browser talks to same-origin /api/backend/* by default so session cookies stay on
# the frontend origin; the Next.js server then forwards upstream using API_INTERNAL_URL
# (NOT the NEXT_PUBLIC_* vars above, which are only for the NEXT_PUBLIC_USE_BFF=false
# direct-to-API opt-out). Leaving API_INTERNAL_URL unset makes every /api/backend/*
# call — including login — fail closed with 500 UPSTREAM_CONFIG.
NEXT_PUBLIC_USE_BFF=true
# Local (non-Docker) dev: point at the locally running NestJS API.
API_INTERNAL_URL=http://localhost:3000/api
# Docker/E2E dev: use the compose service name instead, e.g. API_INTERNAL_URL=http://api:3000/api

# For local development against a native SQL Server + `npm run dev`, set:
#   NEXT_PUBLIC_API_URL=http://localhost:3000/api
#   NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
#   NEXT_PUBLIC_API_ORIGIN=http://localhost:3000
# (see .env.local.example) — the onrender.com defaults above are for cloud deploys only;
# a fresh local clone must never send local login/test traffic to production.

# Optional local-dev only: allow bare seed aliases (e.g. "admin" -> admin@maintainpro.local).
# Leave unset/false in production. Backend login always expects a valid email.
# NEXT_PUBLIC_LOGIN_DEV_LOCAL_ALIAS=true
