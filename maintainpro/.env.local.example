NODE_ENV=development

# API runtime
PORT=3000
CORS_ORIGIN=http://localhost:3001
FRONTEND_URL=http://localhost:3001

# Frontend runtime
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
NEXT_PUBLIC_API_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_TIMEOUT_MS=60000
# Required by the web app's BFF proxy (apps/web/app/api/backend/[...path]/route.ts) —
# server-side only, NOT NEXT_PUBLIC_-prefixed. Without it every /api/backend/* call,
# including login, fails closed with 500 UPSTREAM_CONFIG. See apps/web/.env.example.
NEXT_PUBLIC_USE_BFF=true
API_INTERNAL_URL=http://localhost:3000/api

# Phase 15 (maintainpro/phase-15-sqlserver-migration): local dev now targets a native
# Microsoft SQL Server instance, not MongoDB — see prisma/schema.prisma and
# docs/PHASE_15_SQLSERVER_MIGRATION.md. Provision SQL Server, create an empty
# MaintainProDev database, then run `npm run db:migrate` (prisma migrate deploy) and
# `npm run db:seed`. MongoDB vars below are kept only for the legacy dual-database
# backup/replication path (see DUAL_DATABASE_REPLICATION.md) — leave them unset/disabled
# for a fresh local SQL Server-only setup.
DATABASE_PROVIDER=sqlserver
DATABASE_URL="sqlserver://localhost:1433;database=MaintainProDev;user=<db_user>;password=<db_password>;schema=dbo;encrypt=true;trustServerCertificate=true"
PRIMARY_DATABASE_URL=
BACKUP_DATABASE_URL=
MONGODB_URI=
MONGO_SYNC_ON_STARTUP=false
DATABASE_REPLICATION_ENABLED=false
DATABASE_REPLICATION_MODE=disabled
DATABASE_REPLICATION_RETRY_ATTEMPTS=5
DATABASE_REPLICATION_RETRY_DELAY_MS=5000
DATABASE_REPLICATION_BATCH_SIZE=100
BACKUP_DATABASE_REQUIRED_FOR_READINESS=false
BACKUP_DATABASE_REQUIRED_FOR_STRICT_MODE=false
REDIS_URL=redis://127.0.0.1:6380
REDIS_REQUIRED_FOR_READINESS=false

# JWT auth - replace before shared environments
JWT_SECRET=replace_with_local_shared_secret_or_leave_blank_if_using_split_secrets
JWT_ACCESS_SECRET=replace_with_local_access_secret
JWT_REFRESH_SECRET=replace_with_local_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Notifications
SENDGRID_API_KEY=
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MaintainPro Alerts <alerts@maintainpro.local>
SMS_ENABLED=false
SMS_API_URL=
SMS_API_KEY=
SMS_API_SECRET=
SMS_AUTH_HEADER=Authorization
SMS_SENDER_ID=MaintainPro
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ERP and push providers
ERP_SYNC_PROVIDER=mock
ERP_SYNC_ALLOW_MOCK_IN_PRODUCTION=false
ERP_PROVIDER_ID=
ERP_API_URL=
ERP_API_KEY=
ERP_AUTH_HEADER=Authorization
ERP_TIMEOUT_MS=15000
PUSH_PROVIDER=noop
PUSH_PROVIDER_ENABLED=false
PUSH_PROVIDER_API_URL=
PUSH_PROVIDER_API_KEY=
PUSH_PROVIDER_AUTH_HEADER=Authorization

# Optional providers
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
RAPIDAPI_GOOGLE_MAP_PLACES_KEY=
RAPIDAPI_COPILOT_API_KEY=
RAPIDAPI_COPILOT_HOST=copilot5.p.rapidapi.com
RAPIDAPI_QR_CODE_API_KEY=
RAPIDAPI_QR_CODE_HOST=simple-qr-code-generator-cheap-and-efficient.p.rapidapi.com
RAPIDAPI_QR_CODE_COLOR=
RAPIDAPI_QR_CODE_BG_COLOR=

# Object storage - Docker dev stack maps MinIO to host port 9002
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ASSET_FOLDER=maintainpro/asset-documents
MINIO_ENDPOINT=localhost
MINIO_PORT=9002
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=replace_with_local_minio_secret
MINIO_BUCKET=maintainpro-files

# Farm/weather defaults
OPENWEATHER_API_KEY=
FARM_DEFAULT_LATITUDE=6.9271
FARM_DEFAULT_LONGITUDE=79.8612
WEATHER_ALERT_FROST_THRESHOLD_C=5
WEATHER_ALERT_RAIN_THRESHOLD_MM=50
TRACEABILITY_PUBLIC_BASE_URL=https://trace.nelnafarm.lk
APP_VERSION=1.2.0