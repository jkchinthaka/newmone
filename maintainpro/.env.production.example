# =============================================================================
# MaintainPro PRODUCTION environment TEMPLATE (placeholders only)
# =============================================================================
# OPERATOR: Copy this file to `.env` on the server (outside Git) and replace
# every placeholder with values from your secret manager.
#
#   copy .env.production.example .env   # then edit — never commit `.env`
#
# These values are NOT deployable credentials. Do not reuse them in production.
# Weak/demo passwords are intentionally avoided.
#
# REQUIRED vs OPTIONAL is labeled per section.
# Cookie Secure defaults to ON in production. HTTP compatibility requires dual opt-in (see below).
# =============================================================================

NODE_ENV=production

# --- REQUIRED: Public URLs / CORS ---
# Prefer https://<PUBLIC_HOST> for production. http://<PUBLIC_HOST> only with approved HTTP mode.
PORT=3000
CORS_ORIGIN=https://<PUBLIC_HOST>
FRONTEND_URL=https://<PUBLIC_HOST>
NEXT_PUBLIC_API_URL=https://<PUBLIC_HOST>/api
NEXT_PUBLIC_API_BASE_URL=https://<PUBLIC_HOST>/api
NEXT_PUBLIC_API_ORIGIN=https://<PUBLIC_HOST>
NEXT_PUBLIC_API_TIMEOUT_MS=60000

# Browser calls same-origin BFF; Web container calls Nest via Docker DNS (never the public IP).
NEXT_PUBLIC_USE_BFF=true
API_INTERNAL_URL=http://api:3000/api

# Cookie Secure policy (fail-closed). Production default is secure cookies.
ALLOW_INSECURE_HTTP=false
COOKIE_SECURE=true
#
# --- Approved HTTP-only compatibility (NOT secure transport) ---
# HTTP does not encrypt credentials, does not protect sessions from interception,
# and does not verify server identity. Prefer HTTPS.
# Only when explicitly approved, set BOTH:
#   ALLOW_INSECURE_HTTP=true
#   COOKIE_SECURE=false
#   CORS_ORIGIN=http://<PUBLIC_HOST>
#   FRONTEND_URL=http://<PUBLIC_HOST>
#   NEXT_PUBLIC_API_ORIGIN=http://<PUBLIC_HOST>
#   NEXT_PUBLIC_API_URL=http://<PUBLIC_HOST>/api
#   NEXT_PUBLIC_API_BASE_URL=http://<PUBLIC_HOST>/api
# COOKIE_SECURE=false without ALLOW_INSECURE_HTTP=true is rejected at runtime.

# --- REQUIRED: MongoDB (Docker Compose production) ---
# Root account — rotate if ever exposed; store only in secret manager.
MONGO_INITDB_ROOT_USERNAME=REPLACE_WITH_MONGO_ROOT_USERNAME
MONGO_INITDB_ROOT_PASSWORD=REPLACE_WITH_LONG_RANDOM_MONGO_ROOT_PASSWORD
MONGO_INITDB_DATABASE=bileeta_db
# Application account used by NestJS / Prisma
MONGO_APP_USERNAME=REPLACE_WITH_MONGO_APP_USERNAME
MONGO_APP_PASSWORD=REPLACE_WITH_LONG_RANDOM_MONGO_APP_PASSWORD
# Unified MaintainPro + FG application database (fail-closed in FG production settings).
PRIMARY_DATABASE_NAME=maintainpro_prod
BACKUP_DATABASE_NAME=bileeta_db
MONGO_DATABASE_NAME=maintainpro_prod
# Connection strings (URL-encode passwords). Prefer Docker DNS host `mongo` inside Compose.
PRIMARY_DATABASE_URL=mongodb://REPLACE_WITH_MONGO_APP_USERNAME:REPLACE_WITH_URL_ENCODED_APP_PASSWORD@mongo:27017/maintainpro_prod?authSource=bileeta_db&replicaSet=rs0
BACKUP_DATABASE_URL=mongodb://REPLACE_WITH_MONGO_APP_USERNAME:REPLACE_WITH_URL_ENCODED_APP_PASSWORD@mongo:27017/bileeta_db?authSource=bileeta_db&replicaSet=rs0
DATABASE_URL=mongodb://REPLACE_WITH_MONGO_APP_USERNAME:REPLACE_WITH_URL_ENCODED_APP_PASSWORD@mongo:27017/maintainpro_prod?authSource=bileeta_db&replicaSet=rs0
MONGODB_URI=mongodb://REPLACE_WITH_MONGO_APP_USERNAME:REPLACE_WITH_URL_ENCODED_APP_PASSWORD@mongo:27017/maintainpro_prod?authSource=bileeta_db&replicaSet=rs0
DATABASE_PROVIDER=mongodb
MONGO_SYNC_ON_STARTUP=false
DATABASE_REPLICATION_ENABLED=true
DATABASE_REPLICATION_MODE=async_outbox
DATABASE_REPLICATION_RETRY_ATTEMPTS=5
DATABASE_REPLICATION_RETRY_DELAY_MS=5000
DATABASE_REPLICATION_BATCH_SIZE=100
BACKUP_DATABASE_REQUIRED_FOR_READINESS=false
BACKUP_DATABASE_REQUIRED_FOR_STRICT_MODE=true
DATABASE_SERVER_SELECTION_TIMEOUT_MS=5000
DATABASE_CONNECT_TIMEOUT_MS=5000

# --- REQUIRED: Redis (Docker network only; do not publish host ports) ---
# Nest/BullMQ uses DB 0 via REDIS_URL. FG cache/Celery uses FG_REDIS_URL (DB 1).
REDIS_URL=redis://redis:6379
FG_REDIS_URL=redis://redis:6379/1

# --- REQUIRED: FG Digital Recording (Django under /fg/) ---
DJANGO_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_DJANGO_SECRET_KEY
DJANGO_ALLOWED_HOSTS=<PUBLIC_HOST>,fg
# CSRF origins must include scheme (http:// for temporary HTTP; https:// when TLS enabled).
DJANGO_CSRF_TRUSTED_ORIGINS=http://<PUBLIC_HOST>
ENVIRONMENT_LABEL=production
FG_DATABASE_BACKEND=mongodb
MONGODB_DATABASE=maintainpro_prod
MONGODB_PRODUCTION_TARGET_DATABASE=maintainpro_prod
FORCE_SCRIPT_NAME=/fg
WAIT_FOR_POSTGRES=0
# Keep false for HTTPS. Set true only for approved temporary HTTP :80 deployments.
ALLOW_INSECURE_HTTP=false
MAINTAINPRO_TENANT_ID=
MAINTAINPRO_REFERENCE_DATABASE=maintainpro_prod
MAINTAINPRO_FG_IMAGE=maintainpro-fg:REPLACE_WITH_GIT_SHA

# --- REQUIRED: JWT secrets (long random; never commit real values) ---
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_JWT_SHARED_OR_LEAVE_IF_SPLIT
JWT_ACCESS_SECRET=REPLACE_WITH_LONG_RANDOM_JWT_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_LONG_RANDOM_JWT_REFRESH_SECRET
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# --- REQUIRED: MinIO / object storage (Compose internal) ---
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=REPLACE_WITH_LONG_RANDOM_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_MINIO_SECRET_KEY
MINIO_BUCKET=maintainpro-files

# --- REQUIRED: Build / release metadata ---
APP_COMMIT_SHA=REPLACE_WITH_GIT_SHA
APP_BUILD_TIMESTAMP=REPLACE_WITH_ISO8601_TIMESTAMP
APP_ENVIRONMENT=production
APP_VERSION=1.2.0
GIT_COMMIT=REPLACE_WITH_GIT_SHA
BUILD_TIME=REPLACE_WITH_ISO8601_TIMESTAMP

# --- OPTIONAL: Notifications ---
SENDGRID_API_KEY=
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MaintainPro Alerts <alerts@example.com>
SMS_ENABLED=false
SMS_API_URL=
SMS_API_KEY=
SMS_API_SECRET=
SMS_AUTH_HEADER=Authorization
SMS_SENDER_ID=MaintainPro
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- OPTIONAL: ERP / push / billing / identity ---
ERP_SYNC_PROVIDER=mock
ERP_SYNC_ALLOW_MOCK_IN_PRODUCTION=false
ERP_PROVIDER_ID=
ERP_API_URL=
ERP_API_KEY=
ERP_AUTH_HEADER=Authorization
ERP_TIMEOUT_MS=15000
PUSH_PROVIDER=noop
PUSH_PROVIDER_ENABLED=false
PUSH_PROVIDER_API_URL=
PUSH_PROVIDER_API_KEY=
PUSH_PROVIDER_AUTH_HEADER=Authorization
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# --- OPTIONAL: Premium integrations / Cloudinary ---
RAPIDAPI_GOOGLE_MAP_PLACES_KEY=
RAPIDAPI_COPILOT_API_KEY=
RAPIDAPI_COPILOT_HOST=copilot5.p.rapidapi.com
RAPIDAPI_QR_CODE_API_KEY=
RAPIDAPI_QR_CODE_HOST=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ASSET_FOLDER=maintainpro/asset-documents

# --- OPTIONAL: Farm / weather ---
OPENWEATHER_API_KEY=
FARM_DEFAULT_LATITUDE=6.9271
FARM_DEFAULT_LONGITUDE=79.8612
WEATHER_ALERT_FROST_THRESHOLD_C=5
WEATHER_ALERT_RAIN_THRESHOLD_MM=50
TRACEABILITY_PUBLIC_BASE_URL=https://trace.example.com