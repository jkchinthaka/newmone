# MaintainPro Production Environment Template
# COPY THIS FILE to a secure location OUTSIDE the repo (e.g., C:\MaintainProData\.env.production)
# NEVER commit real values. NEVER use this file directly in CI/CD.
# All values below are PLACEHOLDERS — replace with real secrets before deploy.

# =============================================================================
# APPLICATION
# =============================================================================
NODE_ENV=production
PORT=3040
HOST=127.0.0.1
APP_VERSION=1.2.0
APP_COMMIT_SHA=<git-commit-sha-from-build>
APP_BUILD_TIMESTAMP=<iso-timestamp-from-build>
APP_ENVIRONMENT=production
APP_SERVICE_NAME=maintainpro-api

# =============================================================================
# DATABASE (SQL Server, Windows Integrated Auth ONLY)
# =============================================================================
# Format: sqlserver://host:port;database=name;integratedSecurity=true;trustServerCertificate=true;encrypt=true
DATABASE_URL=sqlserver://localhost:1433;database=MaintainProProd;integratedSecurity=true;trustServerCertificate=true;encrypt=true
DATABASE_PROVIDER=sqlserver
PRIMARY_DATABASE_URL=
PRIMARY_DATABASE_NAME=MaintainProProd
BACKUP_DATABASE_URL=
BACKUP_DATABASE_NAME=
DATABASE_SERVER_SELECTION_TIMEOUT_MS=5000
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_REPLICATION_ENABLED=false
DATABASE_REPLICATION_MODE=disabled
BACKUP_DATABASE_REQUIRED_FOR_READINESS=false
BACKUP_DATABASE_REQUIRED_FOR_STRICT_MODE=true

# =============================================================================
# JWT SECRETS — GENERATE WITH: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# =============================================================================
# At least one of JWT_SECRET, JWT_ACCESS_SECRET, JWT_REFRESH_SECRET is required (Joi .or())
# Use 64-byte hex strings (128 chars). Rotate annually.
JWT_SECRET=<generate-64-byte-hex-string>
JWT_ACCESS_SECRET=<generate-64-byte-hex-string>
JWT_REFRESH_SECRET=<generate-64-byte-hex-string>
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# =============================================================================
# CORS / FRONTEND / BFF
# =============================================================================
CORS_ORIGIN=https://app.maintainpro.local
FRONTEND_URL=https://app.maintainpro.local
API_INTERNAL_URL=http://127.0.0.1:3040/api
ALLOW_INSECURE_HTTP=false
COOKIE_SECURE=true

# =============================================================================
# STORAGE (Evidence Uploads)
# =============================================================================
# Production local storage requires STORAGE_LOCAL_PRODUCTION=true and a private absolute root.
STORAGE_MODE=minio
STORAGE_UPLOADS_ENABLED=true
STORAGE_LOCAL_ROOT=            # Not used when STORAGE_MODE != local
STORAGE_MAX_FILE_SIZE_MB=10
STORAGE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf

# MinIO (example — adjust for your object store)
MINIO_ENDPOINT=minio.maintainpro.local
MINIO_PORT=9000
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=<minio-access-key>
MINIO_SECRET_KEY=<minio-secret-key>
MINIO_BUCKET=maintainpro-evidence
OBJECT_STORAGE_REQUIRED_FOR_READINESS=true

# =============================================================================
# REDIS (Required in production when REDIS_REQUIRED_IN_PRODUCTION=true)
# =============================================================================
REDIS_URL=redis://:password@localhost:6379/0
REDIS_REQUIRED_FOR_READINESS=true
REDIS_REQUIRED_IN_PRODUCTION=true

# =============================================================================
# EMAIL (SMTP) — Set EMAIL_MODE=live to enable
# =============================================================================
EMAIL_MODE=live
SMTP_HOST=smtp.maintainpro.local
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@maintainpro.local
SMTP_PASS=<smtp-password>
SMTP_FROM=MaintainPro <noreply@maintainpro.local>

# =============================================================================
# OPTIONAL INTEGRATIONS (Set to "live" and provide keys to enable)
# =============================================================================
# ERP
ERP_MODE=disabled
ERP_SYNC_MODE=disabled
ERP_API_URL=
ERP_API_KEY=
ERP_BASE_URL=
ERP_AUTH_HEADER=Authorization
ERP_TIMEOUT_MS=15000
ERP_READ_ONLY_SYNC_ENABLED=false
ERP_STOCK_SYNC_APPLY_ENABLED=false
ERP_STOCK_ENDPOINT=
ERP_TENANT_CODE=
ERP_WAREHOUSE_CODE=

# Billing (Stripe)
BILLING_MODE=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMS
SMS_MODE=disabled
SMS_API_URL=
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=
SMS_AUTH_HEADER=Authorization

# Push
PUSH_MODE=disabled
PUSH_PROVIDER=noop
PUSH_PROVIDER_API_URL=
PUSH_PROVIDER_API_KEY=
PUSH_PROVIDER_AUTH_HEADER=Authorization

# Bileeta (legacy ERP)
BILEETA_API_BASE_URL=
BILEETA_API_USERNAME=
BILEETA_API_PASSWORD=
BILEETA_API_KEY=

# Google OAuth (if used)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# =============================================================================
# FEATURE FLAGS / MODES
# =============================================================================
ALLOW_MOCK_IN_PRODUCTION=false
ALLOW_PUBLIC_REGISTRATION=false
ALLOW_PUBLIC_REGISTRATION_IN_PRODUCTION=false
ALLOW_FACILITY_BACKFILL_APPLY=false
E2E_TEST_MODE=false
SWAGGER_ENABLED=false
SWAGGER_USER=
SWAGGER_PASSWORD=
READINESS_API_KEY=<generate-random-string-for-readiness-endpoint>

# Queue / Operational Alerts
QUEUE_STARTUP_RECONCILIATION_ENABLED=true
QUEUE_RECONCILE_BATCH_SIZE=50
OPERATIONAL_ALERT_EVALUATOR_ENABLED=true
OPERATIONAL_ALERT_EVALUATOR_INTERVAL_MS=60000
OPERATIONAL_ALERT_COOLDOWN_SECONDS=300
OPERATIONAL_ALERT_NOTIFICATION_MODE=disabled
NOTIFICATION_UAT_ENABLED=false
NOTIFICATION_REAL_SENDS_ENABLED=false
NOTIFICATION_UAT_ALLOWED_RECIPIENTS=
FRAUD_CONTROL_ENABLED=true

# HTTP Timeouts
HTTP_KEEP_ALIVE_TIMEOUT_MS=65000
HTTP_HEADERS_TIMEOUT_MS=66000
HEALTHCHECK_DEPENDENCY_TIMEOUT_MS=5000

# =============================================================================
# SEED PASSWORD (for initial SUPER_ADMIN creation only — REMOVE AFTER FIRST LOGIN)
# =============================================================================
# Generate: openssl rand -base64 32
# Store in C:\MaintainProData\.seed-password.local (gitignored, 600 perms)
# MAINTAINPRO_SEED_PASSWORD=<strong-password-12+chars>

# =============================================================================
# CLOUDINARY (if STORAGE_MODE=cloudinary)
# =============================================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ASSET_FOLDER=maintainpro/asset-documents

# =============================================================================
# RAPIDAPI (QR, Places, Copilot) — Optional
# =============================================================================
RAPIDAPI_QR_CODE_API_KEY=
RAPIDAPI_QR_CODE_HOST=simple-qr-code-generator-cheap-and-efficient.p.rapidapi.com
RAPIDAPI_QR_CODE_COLOR=
RAPIDAPI_QR_CODE_BG_COLOR=
RAPIDAPI_GOOGLE_MAP_PLACES_KEY=
RAPIDAPI_COPILOT_API_KEY=
RAPIDAPI_COPILOT_HOST=copilot5.p.rapidapi.com

# =============================================================================
# DUPLICATE ISSUE WINDOW
# =============================================================================
DUPLICATE_ISSUE_WINDOW_DAYS=7

# =============================================================================
# VALIDATION NOTES (from apps/api/src/config/env.validation.ts)
# =============================================================================
# - JWT_SECRET OR JWT_ACCESS_SECRET OR JWT_REFRESH_SECRET must be set (Joi .or())
# - If NODE_ENV=production and REDIS_REQUIRED_IN_PRODUCTION=true → REDIS_URL required
# - If NODE_ENV=production and E2E_TEST_MODE=true → FAIL (blocked)
# - If NODE_ENV=production and any integration MODE=mock → FAIL unless ALLOW_MOCK_IN_PRODUCTION=true
# - If STORAGE_UPLOADS_ENABLED=true and STORAGE_MODE=local → FAIL in production
# - If STORAGE_MODE=minio → MINIO_ENDPOINT, MINIO_ACCESS_KEY, MINIO_SECRET_KEY, MINIO_BUCKET required
# - If STORAGE_MODE=cloudinary → CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET required
# - If EMAIL_MODE=live → SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, SMTP_FROM required
# - If BILLING_MODE=live → STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET required
# - If ERP_MODE=live → ERP_API_URL, ERP_API_KEY required
# - If ERP_MODE=sandbox → ERP_BASE_URL, ERP_API_KEY required
# - ERP_READ_ONLY_SYNC_ENABLED=true requires ERP_STOCK_ENDPOINT when ERP_MODE=live/sandbox
# - NOTIFICATION_REAL_SENDS_ENABLED=true requires NOTIFICATION_UAT_ENABLED=true
# Explicit owner opt-in for private production local evidence storage.
STORAGE_LOCAL_PRODUCTION=false
