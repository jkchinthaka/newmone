# Structural validation fixture for `docker compose ... -f docker-compose.production.yml config`.
# NOT for deployment. Values are obvious non-secrets for CI/local structure checks only.
NODE_ENV=production
CORS_ORIGIN=https://struct.example.invalid
FRONTEND_URL=https://struct.example.invalid
NEXT_PUBLIC_API_URL=https://struct.example.invalid/api
NEXT_PUBLIC_API_BASE_URL=https://struct.example.invalid/api
NEXT_PUBLIC_API_ORIGIN=https://struct.example.invalid
NEXT_PUBLIC_USE_BFF=true
API_INTERNAL_URL=http://api:3000/api
COOKIE_SECURE=true
ALLOW_INSECURE_HTTP=false
MONGO_INITDB_ROOT_USERNAME=struct_root_not_for_deploy
MONGO_INITDB_ROOT_PASSWORD=struct_root_password_not_for_deploy_use_32chars
MONGO_INITDB_DATABASE=bileeta_db
MONGO_APP_USERNAME=struct_app_not_for_deploy
MONGO_APP_PASSWORD=struct_app_password_not_for_deploy_use_32ch
PRIMARY_DATABASE_NAME=nelna
BACKUP_DATABASE_NAME=bileeta_db
MONGO_DATABASE_NAME=nelna
PRIMARY_DATABASE_URL=mongodb://struct_app_not_for_deploy:struct_app_password_not_for_deploy_use_32ch@mongo:27017/nelna?authSource=bileeta_db&replicaSet=rs0
BACKUP_DATABASE_URL=mongodb://struct_app_not_for_deploy:struct_app_password_not_for_deploy_use_32ch@mongo:27017/bileeta_db?authSource=bileeta_db&replicaSet=rs0
DATABASE_URL=mongodb://struct_app_not_for_deploy:struct_app_password_not_for_deploy_use_32ch@mongo:27017/nelna?authSource=bileeta_db&replicaSet=rs0
MONGODB_URI=mongodb://struct_app_not_for_deploy:struct_app_password_not_for_deploy_use_32ch@mongo:27017/nelna?authSource=bileeta_db&replicaSet=rs0
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=struct_jwt_access_secret_not_for_deploy_use_only
JWT_REFRESH_SECRET=struct_jwt_refresh_secret_not_for_deploy_use
JWT_SECRET=struct_jwt_shared_secret_not_for_deploy_use_only
MINIO_ACCESS_KEY=struct_minio_access_not_for_deploy
MINIO_SECRET_KEY=struct_minio_secret_not_for_deploy_32
MINIO_BUCKET=maintainpro-files
# FG Digital Recording (Django) + mobile FG broker — required by docker-compose.production.yml's
# fg / fg-celery-worker / fg-celery-beat / api services. Structural-validation-only values.
DJANGO_SECRET_KEY=struct_django_secret_key_not_for_deploy_use_32ch
DJANGO_ALLOWED_HOSTS=struct.example.invalid
DJANGO_CSRF_TRUSTED_ORIGINS=https://struct.example.invalid
FG_SSO_SIGNING_SECRET=struct_fg_sso_signing_secret_not_for_deploy_32ch
APP_VERSION=1.2.0
APP_COMMIT_SHA=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
APP_BUILD_TIMESTAMP=1970-01-01T00:00:00.000Z
APP_ENVIRONMENT=struct-validation
MAINTAINPRO_API_IMAGE=maintainpro-api:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
MAINTAINPRO_WEB_IMAGE=maintainpro-web:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
