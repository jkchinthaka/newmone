  @@index([tenantId])
  @@index([employeeId])
  @@index([workOrderId])
  @@index([assignmentStatus])
}

/// Configurable Failure / Cause / Remedy codes (technician RCA — not requester Problem Category)
model MaintenanceAnalysisCode {
  id          String   @id @default(cuid()) @db.NVarChar(36)
  tenantId    String   @db.NVarChar(36)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  kind        String   @db.NVarChar(64)
  code        String
  name        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
