model TrafficFine {
  id               String      @id @default(cuid()) @db.NVarChar(36)
  /// MP-003: required — see Asset.tenantId comment for rationale.
  tenantId         String      @db.NVarChar(36)
  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// MP-003: tenant-scoped — see @@unique([tenantId, fineNumber]) below. fineNumber here is
  /// MaintainPro's own internal generated reference (FIN-<year>-NNNNN, see nextFineNumber()),
  /// not the government/traffic-authority citation number — that external identifier isn't
  /// modeled as its own field, so no separate global-vs-tenant question applies to it.
  fineNumber       String      @db.NVarChar(64)
  vehicleId        String      @db.NVarChar(36)
  vehicle          Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  driverId         String?     @db.NVarChar(36)
  driver           Driver?     @relation(fields: [driverId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reportedById     String      @db.NVarChar(36)
  reportedBy       User        @relation("TrafficFineReporter", fields: [reportedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fineDate         DateTime
  dueDate          DateTime?
  location         String?
  violationCode    String?
  description      String
  fineAmount       Float
  issuingAuthority String?
  responsibility   String      @default("") @db.NVarChar(64)
  documentRelated  Boolean     @default(false)
  paymentStatus    String      @default("") @db.NVarChar(64)
  paidAt           DateTime?
  paidAmount       Float?
  paymentReference String?
  evidenceUrls     String      @default("[]") @db.NVarChar(Max)
  notes            String?
  workOrders       WorkOrder[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

