model SparePart {
  id                  String    @id @default(cuid()) @db.NVarChar(36)
  /// MP-003: required — see Asset.tenantId comment for rationale.
  tenantId            String    @db.NVarChar(36)
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// MP-003: tenant-scoped — see @@unique([tenantId, partNumber]) below. InventoryService.createPart()
  /// already ran a { tenantId, partNumber } duplicate check with the message "Part number must be
  /// unique within tenant context" before this migration — the DB constraint was stricter (global)
  /// than the application's own documented intent, so a second tenant reusing a part number already
  /// used by another tenant would pass that app-level check and then fail with a raw, unhandled
  /// Prisma unique-constraint error at the create() call. ERP matching (erp-excel-import.service.ts,
  /// erp-stock-sync.service.ts) already scopes every SparePart lookup by tenantId before building its
  /// in-memory part-number maps, so no ERP call site required changes for this migration.
  partNumber          String    @db.NVarChar(64)
  name                String
  description         String?
  category            String
  /// SPARE_PART | CONSUMABLE | TOOL — maintenance classification (not Bileeta item master).
  classification      String    @default("") @db.NVarChar(64)
  /// Official ERP/Bileeta item code when mapped; MaintainPro never owns purchasing stock truth.
  erpCode             String?
  /// Maintenance-friendly alias for technicians.
  maintenanceAlias    String?
  maintenanceCategory String?
  unit                String    @default("pcs")
  /// ON_HAND (denormalized default-warehouse / company total for current single-warehouse tenants).
  quantityInStock     Int       @default(0)
  /// RESERVED units held for approved work-order demand.
  reservedQuantity    Int       @default(0)
  /// AVAILABLE = ON_HAND - RESERVED. Maintained atomically by InventoryTransactionEngine.
  availableQuantity   Int       @default(0)
  /// Reference/available stock hint from ERP sync — not authoritative purchasing stock.
  referenceStock      Int?
  minimumStock        Int       @default(0)
  reorderPoint        Int       @default(0)
  maximumStock        Int       @default(0)
  unitCost            Decimal   @db.Decimal(18, 2)
  location            String?
  supplierId          String?   @db.NVarChar(36)
  supplier            Supplier? @relation(fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  images              String    @default("[]") @db.NVarChar(Max)
  isActive            Boolean   @default(true)
  leadTimeDays        Int?
  /// CRITICAL | NORMAL. Consumables may omit serial/warranty tracking.
  criticality         String?
  criticalSpare       Boolean   @default(false)
  warrantyDays        Int?
  warrantyMileage     Float?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  stockMovements             StockMovement[]
  workOrderParts             WorkOrderPart[]
  partRequests               PartRequest[]
  partIssues                 PartIssue[]
  purchaseOrderLines         PurchaseOrderLine[]
  warehouseBalances          WarehouseItemBalance[]
  compatibilities            PartCompatibility[]
  installedParts             InstalledPart[]
  procurementRecommendations ProcurementRecommendation[]

  @@unique([tenantId, partNumber])
  @@index([tenantId])
  @@index([supplierId])
  @@index([tenantId, isActive])
  @@index([tenantId, classification])
  @@index([tenantId, erpCode])
  @@index([tenantId, criticalSpare])
}

