  assignmentStatus String    @default("") @db.NVarChar(64)
  assignedById     String?   @db.NVarChar(36)
  assignedBy       User?     @relation("WorkOrderAssigneeAssignedBy", fields: [assignedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignedAt       DateTime  @default(now())
  remarks          String?
  leaveOverride    Boolean   @default(false)
  createdAt        DateTime  @default(now())
