model WorkOrder {
  id                          String               @id @default(cuid()) @db.NVarChar(36)
  /// MP-003: required — see Asset.tenantId comment for rationale.
  tenantId                    String               @db.NVarChar(36)
  tenant                      Tenant               @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// MP-003: tenant-scoped — see @@unique([tenantId, woNumber]) below. WorkOrdersService.nextWoNumber()
  /// already generates "WO-<year>-NNNN" scoped to the current tenant only (it queries the latest
  /// woNumber WHERE tenantId = <actor's tenant>), so under the old global constraint two different
  /// tenants' first work orders of a year would both compute "WO-2026-0001" and the second tenant's
  /// create would fail (and exhaust createWithNumberRetry's 8 attempts, since retrying recomputes the
  /// same already-taken number every time) — a real latent bug, just never observed because only one
  /// tenant existed in seeded data. This constraint makes that generation scheme actually correct.
  woNumber                    String               @db.NVarChar(64)
  title                       String
  description                 String
  priority                    String               @default("") @db.NVarChar(64)
  status                      String               @default("") @db.NVarChar(64)
  approvalStatus              String               @default("") @db.NVarChar(64)
  approvedById                String?              @db.NVarChar(36)
  approvedBy                  User?                @relation("ApprovedWorkOrders", fields: [approvedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approvedAt                  DateTime?
  rejectionReason             String?
  type                        String               @db.NVarChar(64)
  assetId                     String?              @db.NVarChar(36)
  asset                       Asset?               @relation(fields: [assetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vehicleId                   String?              @db.NVarChar(36)
  vehicle                     Vehicle?             @relation(fields: [vehicleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  scheduleId                  String?              @db.NVarChar(36)
  schedule                    MaintenanceSchedule? @relation(fields: [scheduleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdById                 String               @db.NVarChar(36)
  createdBy                   User                 @relation("CreatorWorkOrders", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  technicianId                String?              @db.NVarChar(36)
  technician                  User?                @relation("TechnicianWorkOrders", fields: [technicianId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dueDate                     DateTime?
  expectedCompletionDate      DateTime?
  plannedStartAt              DateTime?
  plannedEndAt                DateTime?
  delayReason                 String?
  cancelledReason             String?
  technicianCompletionNote    String?
  verificationStatus          String               @default("") @db.NVarChar(64)
  verifiedById                String?              @db.NVarChar(36)
  verifiedBy                  User?                @relation("VerifiedWorkOrders", fields: [verifiedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  verifiedAt                  DateTime?
  verificationNote            String?
  verificationRejectionReason String?
  reopenReason                String?
  reopenedAt                  DateTime?
  reopenedById                String?              @db.NVarChar(36)
  reopenedBy                  User?                @relation("ReopenedWorkOrders", fields: [reopenedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  startDate                   DateTime?
  completedDate               DateTime?
  estimatedCost               Decimal?             @db.Decimal(18, 2)
  actualCost                  Decimal?             @db.Decimal(18, 2)
  /// INTERNAL | EXTERNAL | MIXED — who executes the work.
  executionMode               String               @default("") @db.NVarChar(64)
  vendorSupplierId            String?              @db.NVarChar(36)
  vendorSupplier              Supplier?            @relation("WorkOrderVendorSupplier", fields: [vendorSupplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  estimatedHours              Float?
  actualHours                 Float?
  slaDeadline                 DateTime?
  slaBreached                 Boolean              @default(false)
  notes                       String?
  attachments                 String               @default("[]") @db.NVarChar(Max)
  completionCondition         String?              @db.NVarChar(64)
  followUpRequired            Boolean              @default(false)
  followUpNote                String?
  qrVerificationStatus        String               @default("") @db.NVarChar(64)
  qrVerifiedAt                DateTime?
  qrVerifiedById              String?              @db.NVarChar(36)
  qrVerifiedBy                User?                @relation("QrVerifiedWorkOrders", fields: [qrVerifiedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  qrVerifiedAssetId           String?              @db.NVarChar(36)
  qrVerifiedVehicleId         String?              @db.NVarChar(36)
  qrOverrideReason            String?
  accidentId                  String?              @db.NVarChar(36)
  accident                    AccidentReport?      @relation(fields: [accidentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  trafficFineId               String?              @db.NVarChar(36)
  trafficFine                 TrafficFine?         @relation(fields: [trafficFineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Phase 5: location-only WO support (CORRECTIVE/EMERGENCY may omit asset)
  siteId                      String?              @db.NVarChar(36)
  site                        Site?                @relation(fields: [siteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  functionalLocationId        String?              @db.NVarChar(36)
  functionalLocation          FunctionalLocation?  @relation(fields: [functionalLocationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  departmentId                String?              @db.NVarChar(36)
  department                  Department?          @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  domainId                    String?              @db.NVarChar(36)
  domain                      AssetDomain?         @relation(fields: [domainId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// MACHINERY | SERVICE | VEHICLE — first-class ops lane on the unified WO engine
  jobDomain                   String?              @db.NVarChar(32)
  /// Versioned maintenance template applied at create (immutable snapshot below)
  maintenanceTemplateId       String?              @db.NVarChar(36)
  maintenanceTemplate         MaintenanceTemplate? @relation(fields: [maintenanceTemplateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  maintenanceTemplateVersion  Int?
  maintenanceTemplateSnapshot String?              @db.NVarChar(Max)
  underWarranty               Boolean              @default(false)
  /// Reverse unique link also on MaintenanceRequest.workOrderId — keep both for query convenience
  maintenanceRequest          MaintenanceRequest?

  // Phase 6 — operational timestamps (do not derive KPIs solely from updatedAt)
  failedAt                 DateTime?
  reportedAt               DateTime?
  acknowledgedAt           DateTime?
  technicianArrivedAt      DateTime?
  repairStartedAt          DateTime?
  repairCompletedAt        DateTime?
  productionResumedAt      DateTime?
  closedAt                 DateTime?
  estimatedDurationMinutes Int?

  // Phase 6 — hold (current state; history in WorkOrderHoldHistory)
  holdReasonCode   String?
  holdNotes        String?
  heldAt           DateTime?
  expectedResumeAt DateTime?
  resumedAt        DateTime?

  // Phase 6 — downtime (optional by domain; not forced on every WO)
  affectsOperation   Boolean   @default(false)
  downtimeApplicable Boolean   @default(false)
  downtimeStartedAt  DateTime?
  downtimeEndedAt    DateTime?
  downtimeReason     String?
  /// Candidate flag from configurable repeat-failure detection (not automatic blame)
  repeatFailureCandidate Boolean @default(false)

  // Phase 6 — RCA (technician analysis; distinct from requester Problem Category)
  failureCodeId       String?                  @db.NVarChar(36)
  failureCode         MaintenanceAnalysisCode? @relation("WoFailureCode", fields: [failureCodeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  causeCodeId         String?                  @db.NVarChar(36)
  causeCode           MaintenanceAnalysisCode? @relation("WoCauseCode", fields: [causeCodeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  remedyCodeId        String?                  @db.NVarChar(36)
  remedyCode          MaintenanceAnalysisCode? @relation("WoRemedyCode", fields: [remedyCodeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  failureCodeSnapshot String?
  causeCodeSnapshot   String?
  remedyCodeSnapshot  String?

  // Phase 6 — maintenance-level safety metadata (not full EHS)
  riskLevel           String?
  ppeRequired         String  @default("[]") @db.NVarChar(Max)
  lotoRequired        Boolean @default(false)
  hotWorkRequired     Boolean @default(false)
  workingAtHeight     Boolean @default(false)
  electricalIsolation Boolean @default(false)
  confinedSpace       Boolean @default(false)
  permitReference     String?

  correctionReason   String?
  lastIdempotencyKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  maintenanceLogs     MaintenanceLog[]
  parts               WorkOrderPart[]
  partRequests        PartRequest[]
  partIssues          PartIssue[]
  facilityIssue       FacilityIssue?
  evidenceAttachments EvidenceAttachment[]
  assignees           WorkOrderAssignee[]
  vendorRepairCase    VendorRepairCase?
  holdHistory         WorkOrderHoldHistory[]
  labourEntries       WorkOrderLabourEntry[]
  statusHistory       WorkOrderStatusHistory[]
  costSnapshot        WorkOrderCostSnapshot?
  repairWarranties    RepairWarranty[]
  warrantyClaims      WarrantyClaim[]
  downtimeSegments    DowntimeSegment[]
  rcaCases            RcaCase[]
  workPermits         WorkPermit[]

  /// Phase 8 PM source traceability
  pmPlanId        String? @db.NVarChar(36)
  pmPlan          PmPlan? @relation(fields: [pmPlanId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pmPlanRevision  Int?
  pmTriggerSource String?
  pmOccurrenceKey String?

  taxonomyCategoryId   String?            @db.NVarChar(36)
  taxonomyCategory     WorkOrderTaxonomy? @relation("WorkOrderTaxonomyCategory", fields: [taxonomyCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  taxonomyTypeId       String?            @db.NVarChar(36)
  taxonomyType         WorkOrderTaxonomy? @relation("WorkOrderTaxonomyType", fields: [taxonomyTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  taxonomyIssueId      String?            @db.NVarChar(36)
  taxonomyIssue        WorkOrderTaxonomy? @relation("WorkOrderTaxonomyIssue", fields: [taxonomyIssueId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  installedParts       InstalledPart[]
  categoryNameSnapshot String?
  typeNameSnapshot     String?
  issueNameSnapshot    String?
  isTriage             Boolean            @default(false)
  triageReason         String?
  triageClassifiedAt   DateTime?
  triageClassifiedById String?            @db.NVarChar(36)

  @@unique([tenantId, woNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, updatedAt])
  @@index([tenantId, isTriage])
  @@index([tenantId, dueDate])
  @@index([tenantId, siteId])
  @@index([tenantId, functionalLocationId])
  @@index([tenantId, assetId, status])
  @@index([tenantId, completedDate])
  @@index([tenantId, closedAt])
  @@index([tenantId, pmPlanId])
  @@index([tenantId, pmOccurrenceKey])
  @@index([tenantId, vendorSupplierId])
  @@index([tenantId, executionMode])
  @@index([tenantId, jobDomain])
  @@index([tenantId, jobDomain, status])
  @@index([tenantId, maintenanceTemplateId])
  @@index([status])
  @@index([priority])
  @@index([technicianId])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([dueDate])
  @@index([expectedCompletionDate])
  @@index([plannedEndAt])
  @@index([accidentId])
  @@index([trafficFineId])
  @@index([taxonomyCategoryId])
  @@index([taxonomyTypeId])
  @@index([taxonomyIssueId])
  @@index([isTriage])
  @@index([tenantId, lastIdempotencyKey])
}

model WorkOrderTaxonomy {
  id                             String              @id @default(cuid()) @db.NVarChar(36)
  tenantId                       String?             @db.NVarChar(36)
  tenant                         Tenant?             @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  code                           String
  name                           String
  description                    String?
  parentId                       String?             @db.NVarChar(36)
  parent                         WorkOrderTaxonomy?  @relation("WorkOrderTaxonomyHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children                       WorkOrderTaxonomy[] @relation("WorkOrderTaxonomyHierarchy")
  level                          String              @db.NVarChar(64)
  active                         Boolean             @default(true)
  sortOrder                      Int                 @default(0)
  departmentScope                String?
  defaultPriority                String?             @db.NVarChar(64)
  defaultSlaHours                Int?
  requiresAsset                  Boolean             @default(false)
  requiresVehicle                Boolean             @default(false)
  requiresLocation               Boolean             @default(false)
  requiresEvidence               Boolean             @default(false)
  requiresSupervisorVerification Boolean             @default(false)
  requiresPartsReview            Boolean             @default(false)
  requiresFinanceApproval        Boolean             @default(false)
  gateOutBlockingRisk            Boolean             @default(false)
  downtimeTrackingRequired       Boolean             @default(false)
  allowedRoles                   String              @default("[]") @db.NVarChar(Max)
  aliases                        String              @default("[]") @db.NVarChar(Max)
  keywords                       String              @default("[]") @db.NVarChar(Max)
  commonMistakes                 String              @default("[]") @db.NVarChar(Max)
  sinhalaKeywords                String              @default("[]") @db.NVarChar(Max)
  departmentHints                String              @default("[]") @db.NVarChar(Max)
  createdById                    String?             @db.NVarChar(36)
  updatedById                    String?             @db.NVarChar(36)
  createdAt                      DateTime            @default(now())
  updatedAt                      DateTime            @updatedAt

  workOrdersAsCategory WorkOrder[] @relation("WorkOrderTaxonomyCategory")
  workOrdersAsType     WorkOrder[] @relation("WorkOrderTaxonomyType")
  workOrdersAsIssue    WorkOrder[] @relation("WorkOrderTaxonomyIssue")

  @@unique([tenantId, code])
  @@index([tenantId, level, active])
  @@index([parentId])
  @@index([tenantId, sortOrder])
}

/// Workforce / technician master — assignable to work orders with or without login.
model Employee {
  id                   String      @id @default(cuid()) @db.NVarChar(36)
  tenantId             String?     @db.NVarChar(36)
  tenant               Tenant?     @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employeeNo           String?
  fullName             String
  phone                String?
  email                String?
  /// Optional branch/site label until Branch master exists
  branchName           String?
  departmentId         String?     @db.NVarChar(36)
  department           Department? @relation("EmployeeDepartment", fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  designation          String
  skills               String      @default("[]") @db.NVarChar(Max)
  workCategories       String      @default("[]") @db.NVarChar(Max)
  shift                String?
  availabilityStatus   String      @default("") @db.NVarChar(64)
  canReceiveWorkOrders Boolean     @default(true)
  dailyCapacityHours   Float       @default(8)
  active               Boolean     @default(true)
  canLogin             Boolean     @default(false)
  linkedUserId         String?     @db.NVarChar(36)
