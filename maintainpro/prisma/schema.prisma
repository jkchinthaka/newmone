// =============================================================================
// Phase 7 — Configurable Approval & Control Engine
// Procurement PartRequestApproval / PurchaseOrderApproval remain domain-separate.
// Rule versions are immutable snapshots; edits create a new version row.
// Missing approver resolution never auto-approves.
// =============================================================================

/// Versioned rule definition. Never mutate in place once referenced by requests —
/// deactivate and create version+1 so historical decisions stay tied to original logic.
model ApprovalRule {
  id                       String    @id @default(cuid()) @db.NVarChar(36)
  tenantId                 String    @db.NVarChar(36)
  tenant                   Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name                     String
  processType              String    @db.NVarChar(64)
  trigger                  String    @db.NVarChar(64)
  /// Structured conditions only — never executable code. Shape: [{ field, operator, value }]
  conditions               String    @default("[]") @db.NVarChar(Max)
  siteId                   String?   @db.NVarChar(36)
  departmentId             String?   @db.NVarChar(36)
  domainId                 String?   @db.NVarChar(36)
  priorityScope            String    @default("[]") @db.NVarChar(Max)
  workTypeScope            String    @default("[]") @db.NVarChar(Max)
  amountThreshold          Decimal?  @db.Decimal(18, 2)
  amountField              String?
  slaHours                 Int?
  escalateToBackup         Boolean   @default(true)
  emergencyOverrideAllowed Boolean   @default(false)
  effectiveFrom            DateTime  @default(now())
  effectiveTo              DateTime?
  version                  Int       @default(1)
  /// Same logical rule family across versions (first version id or shared key)
  ruleFamilyKey            String
  isActive                 Boolean   @default(true)
  createdById              String    @db.NVarChar(36)
  createdBy                User      @relation("ApprovalRuleCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedById              String?   @db.NVarChar(36)
  updatedBy                User?     @relation("ApprovalRuleUpdatedBy", fields: [updatedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  levels   ApprovalRuleLevel[]
  requests ApprovalRequest[]

  @@index([tenantId, processType, isActive])
  @@index([tenantId, ruleFamilyKey, version])
  @@index([tenantId, effectiveFrom, effectiveTo])
  @@index([tenantId, isActive, processType])
}

model ApprovalRuleLevel {
  id             String       @id @default(cuid()) @db.NVarChar(36)
  tenantId       String       @db.NVarChar(36)
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ruleId         String       @db.NVarChar(36)
  rule           ApprovalRule @relation(fields: [ruleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  level          Int
  approverRole   String?      @db.NVarChar(64)
  approverUserId String?      @db.NVarChar(36)
  approverUser   User?        @relation("ApprovalRuleLevelUser", fields: [approverUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  backupUserId   String?      @db.NVarChar(36)
  backupUser     User?        @relation("ApprovalRuleLevelBackup", fields: [backupUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([ruleId, level])
  @@index([tenantId, ruleId])
}

model ApprovalRequest {
  id                      String       @id @default(cuid()) @db.NVarChar(36)
  tenantId                String       @db.NVarChar(36)
  tenant                  Tenant       @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  processType             String       @db.NVarChar(64)
  subjectEntityType       String
  subjectEntityId         String
  triggeredRuleId         String       @db.NVarChar(36)
  triggeredRule           ApprovalRule @relation(fields: [triggeredRuleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  triggeredRuleVersion    Int
  /// Immutable snapshot of rule + levels + conditions at request creation
  ruleSnapshot            String       @db.NVarChar(Max)
  sourceContext           String?      @db.NVarChar(Max)
  requesterId             String       @db.NVarChar(36)
  requester               User         @relation("ApprovalRequestRequester", fields: [requesterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requestedAt             DateTime     @default(now())
  status                  String       @default("") @db.NVarChar(64)
  completedAt             DateTime?
  cancellationReason      String?
  emergencyOverrideAt     DateTime?
  emergencyOverrideById   String?      @db.NVarChar(36)
  emergencyOverrideReason String?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  steps     ApprovalStep[]
  decisions ApprovalDecision[]

  @@index([tenantId, status, requestedAt])
  @@index([tenantId, processType, status])
  @@index([tenantId, subjectEntityType, subjectEntityId])
  @@index([tenantId, requesterId, status])
}

model ApprovalStep {
  id                 String          @id @default(cuid()) @db.NVarChar(36)
  tenantId           String          @db.NVarChar(36)
  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approvalRequestId  String          @db.NVarChar(36)
  approvalRequest    ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  level              Int
  approverRole       String?         @db.NVarChar(64)
  assignedApproverId String?         @db.NVarChar(36)
  assignedApprover   User?           @relation("ApprovalStepAssignee", fields: [assignedApproverId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  backupApproverId   String?         @db.NVarChar(36)
  backupApprover     User?           @relation("ApprovalStepBackup", fields: [backupApproverId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status             String          @default("") @db.NVarChar(64)
  dueAt              DateTime?
  actedAt            DateTime?
  escalatedAt        DateTime?
  escalationState    String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  decisions ApprovalDecision[]

  @@unique([approvalRequestId, level])
  @@index([tenantId, assignedApproverId, status])
  @@index([tenantId, status, dueAt])
  @@index([tenantId, backupApproverId, status])
}

model ApprovalDecision {
  id                String          @id @default(cuid()) @db.NVarChar(36)
  tenantId          String          @db.NVarChar(36)
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approvalRequestId String          @db.NVarChar(36)
  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approvalStepId    String          @db.NVarChar(36)
  approvalStep      ApprovalStep    @relation(fields: [approvalStepId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actorId           String          @db.NVarChar(36)
  actor             User            @relation("ApprovalDecisionActor", fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  decision          String          @db.NVarChar(64)
  reason            String?
  decidedAt         DateTime        @default(now())
  createdAt         DateTime        @default(now())

  @@index([tenantId, approvalRequestId, decidedAt])
  @@index([tenantId, actorId, decidedAt])
}

// ---------------------------------------------------------------------------
// Phase 8 ΓÇö Generic PM / meter / inspection / calibration / compliance engine
// ---------------------------------------------------------------------------

/// EARLIEST = OR / whichever comes first; ALL = AND / every trigger must be due.
/// Preventive maintenance plan (revisioned). One generic engine for all domains.
model PmPlan {
  id                       String               @id @default(cuid()) @db.NVarChar(36)
  tenantId                 String               @db.NVarChar(36)
  tenant                   Tenant               @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  code                     String
  name                     String
  description              String?
  status                   String               @default("") @db.NVarChar(64)
  assetId                  String?              @db.NVarChar(36)
  asset                    Asset?               @relation(fields: [assetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vehicleId                String?              @db.NVarChar(36)
  vehicle                  Vehicle?             @relation(fields: [vehicleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  location                 String? // legacy free-text; prefer siteId/FL
  teamId                   String?              @db.NVarChar(36)
  estimatedDurationMinutes Int?
  requiredParts            PmPlanRequiredPart[]
  checklistTemplateId      String?              @db.NVarChar(36)
  checklistTemplate        ChecklistTemplate?   @relation(fields: [checklistTemplateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  gracePeriodDays          Int                  @default(0)
  siteId                   String?              @db.NVarChar(36)
  site                     Site?                @relation(fields: [siteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  functionalLocationId     String?              @db.NVarChar(36)
  functionalLocation       FunctionalLocation?  @relation(fields: [functionalLocationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  domainId                 String?              @db.NVarChar(36)
  priority                 String               @default("") @db.NVarChar(64)
  workType                 String               @default("") @db.NVarChar(64)
  autoCreateWorkOrder      Boolean              @default(true)
  combineMode              String               @default("") @db.NVarChar(64)
  currentRevision          Int                  @default(1)
  effectiveFrom            DateTime?
  effectiveTo              DateTime?
  lastCompletionAt         DateTime?
  lastCompletionMileage    Float?
  lastCompletionHours      Float?
  nextDueAt                DateTime?
  nextDueMeterValue        Float?
  nextDueMeterId           String?              @db.NVarChar(36)
  legacyScheduleId         String?              @db.NVarChar(36)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  revisions   PmPlanRevision[]
  triggers    PmTrigger[]
  workOrders  WorkOrder[]
  generations PmAutoGeneration[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, nextDueAt])
  @@index([assetId])
  @@index([vehicleId])
  @@index([checklistTemplateId])
  @@index([tenantId, siteId])
  @@index([tenantId, functionalLocationId])
}

model PmPlanRevision {
  id            String    @id @default(cuid()) @db.NVarChar(36)
  tenantId      String    @db.NVarChar(36)
  planId        String    @db.NVarChar(36)
  plan          PmPlan    @relation(fields: [planId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  revision      Int
  effectiveFrom DateTime
  effectiveTo   DateTime?
  snapshot      String    @db.NVarChar(Max)
  changeReason  String?
  createdById   String?   @db.NVarChar(36)
  createdAt     DateTime  @default(now())

  @@unique([planId, revision])
  @@index([tenantId, planId])
  @@index([planId, effectiveFrom])
}

model PmTrigger {
  id            String      @id @default(cuid()) @db.NVarChar(36)
  tenantId      String      @db.NVarChar(36)
  planId        String      @db.NVarChar(36)
  plan          PmPlan      @relation(fields: [planId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  kind          String      @db.NVarChar(64)
  /// Triggers sharing the same group are combined per plan.combineMode.
  combineGroup  Int         @default(0)
  intervalDays  Int?
  intervalValue Float?
  meterType     String?     @db.NVarChar(64)
  meterId       String?     @db.NVarChar(36)
  meter         AssetMeter? @relation(fields: [meterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unit          String?
  /// EXPIRY compliance type key, CONDITION expression, or EVENT type.
  referenceKey  String?
  metadata      String?     @db.NVarChar(Max)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([tenantId, planId])
  @@index([planId, kind])
  @@index([meterId])
}

/// Idempotent record of auto-generated WOs so due evaluation cannot double-create.
model PmAutoGeneration {
  id             String   @id @default(cuid()) @db.NVarChar(36)
  tenantId       String   @db.NVarChar(36)
  planId         String   @db.NVarChar(36)
  plan           PmPlan   @relation(fields: [planId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Stable key for the due window (e.g. planId + nextDueAt ISO date).
  generationKey  String
  workOrderId    String?  @db.NVarChar(36)
  triggerSummary String?  @db.NVarChar(Max)
  createdAt      DateTime @default(now())

  @@unique([tenantId, planId, generationKey])
  @@index([tenantId, planId])
}

model AssetMeter {
  id                   String    @id @default(cuid()) @db.NVarChar(36)
  tenantId             String    @db.NVarChar(36)
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assetId              String?   @db.NVarChar(36)
  asset                Asset?    @relation(fields: [assetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vehicleId            String?   @db.NVarChar(36)
  vehicle              Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  meterType            String    @db.NVarChar(64)
  name                 String
  unit                 String
  currentValue         Float     @default(0)
  lastReadingAt        DateTime?
  staleAfterDays       Int       @default(30)
  /// Absolute jump above this delta raises SUSPICIOUS_JUMP (warning, still accepted).
  jumpWarningThreshold Float?
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  readings AssetMeterReading[]
  triggers PmTrigger[]

  @@index([tenantId, assetId])
  @@index([tenantId, vehicleId])
  @@index([tenantId, meterType])
}

model AssetMeterReading {
  id             String     @id @default(cuid()) @db.NVarChar(36)
  tenantId       String     @db.NVarChar(36)
  meterId        String     @db.NVarChar(36)
  meter          AssetMeter @relation(fields: [meterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  value          Float
  previousValue  Float?
  source         String     @default("") @db.NVarChar(64)
  recordedById   String?    @db.NVarChar(36)
  deviceId       String?
  recordedAt     DateTime   @default(now())
  isStale        Boolean    @default(false)
  suspiciousJump Boolean    @default(false)
  rejected       Boolean    @default(false)
  rejectReason   String?
  notes          String?
  createdAt      DateTime   @default(now())

  @@index([tenantId, meterId, recordedAt])
  @@index([meterId, recordedAt])
}

model ChecklistTemplate {
  id            String    @id @default(cuid()) @db.NVarChar(36)
  tenantId      String    @db.NVarChar(36)
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  code          String
  name          String
  description   String?
  version       Int       @default(1)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  domainKey     String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items               ChecklistTemplateItem[]
  pmPlans             PmPlan[]
  inspectionTemplates InspectionTemplate[]
  maintenanceTemplates MaintenanceTemplate[]

  @@unique([tenantId, code, version])
  @@index([tenantId, isActive])
  @@index([tenantId, domainKey])
}

model ChecklistTemplateItem {
  id                 String            @id @default(cuid()) @db.NVarChar(36)
  tenantId           String            @db.NVarChar(36)
  templateId         String            @db.NVarChar(36)
  template           ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sortOrder          Int               @default(0)
  key                String
  label              String
  type               String            @db.NVarChar(64)
  required           Boolean           @default(false)
  unit               String?
  minValue           Float?
  maxValue           Float?
  options            String            @default("[]") @db.NVarChar(Max)
  /// SIGNATURE justified only when this is true and business requires attestation.
  signatureJustified Boolean           @default(false)
  metadata           String?           @db.NVarChar(Max)
  createdAt          DateTime          @default(now())

  @@unique([templateId, key])
  @@index([templateId, sortOrder])
}

model InspectionTemplate {
  id                  String             @id @default(cuid()) @db.NVarChar(36)
  tenantId            String             @db.NVarChar(36)
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  code                String
  name                String
  description         String?
  version             Int                @default(1)
  effectiveFrom       DateTime           @default(now())
  effectiveTo         DateTime?
  checklistTemplateId String?            @db.NVarChar(36)
  checklistTemplate   ChecklistTemplate? @relation(fields: [checklistTemplateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  domainKey           String?
  isActive            Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  inspections Inspection[]

  @@unique([tenantId, code, version])
  @@index([tenantId, isActive])
}

model Inspection {
  id                    String              @id @default(cuid()) @db.NVarChar(36)
  tenantId              String              @db.NVarChar(36)
  tenant                Tenant              @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  templateId            String?             @db.NVarChar(36)
  template              InspectionTemplate? @relation(fields: [templateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assetId               String?             @db.NVarChar(36)
  asset                 Asset?              @relation(fields: [assetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vehicleId             String?             @db.NVarChar(36)
  vehicle               Vehicle?            @relation(fields: [vehicleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inspectorId           String?             @db.NVarChar(36)
  scheduledAt           DateTime?
  performedAt           DateTime?
  isAdHoc               Boolean             @default(false)
  result                String?             @db.NVarChar(64)
  findings              String?
  evidenceUrls          String              @default("[]") @db.NVarChar(Max)
  answers               String?             @db.NVarChar(Max)
  correctiveWorkOrderId String?             @db.NVarChar(36)
  status                String              @default("OPEN")
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  findingRecords InspectionFinding[]

  @@index([tenantId, status])
  @@index([tenantId, result])
  @@index([assetId])
  @@index([vehicleId])
  @@index([templateId])
}

model CalibrationRecord {
  id                    String    @id @default(cuid()) @db.NVarChar(36)
  tenantId              String    @db.NVarChar(36)
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  equipmentAssetId      String?   @db.NVarChar(36)
  equipmentAsset        Asset?    @relation(fields: [equipmentAssetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  calibrationType       String
  lastCalibratedAt      DateTime?
  nextDueAt             DateTime?
  vendorId              String?   @db.NVarChar(36)
  vendorName            String?
  certificateUrl        String?
  result                String?   @db.NVarChar(64)
  tolerance             String?
  measuredValue         Float?
  passFail              Boolean?
  correctiveAction      String?
  correctiveWorkOrderId String?   @db.NVarChar(36)
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([tenantId, nextDueAt])
  @@index([tenantId, equipmentAssetId])
  @@index([tenantId, result])
}

/// Generic expiry/compliance engine (insurance, licence, fire, warranty, etc.).
model ComplianceRequirement {
  id              String    @id @default(cuid()) @db.NVarChar(36)
  tenantId        String    @db.NVarChar(36)
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Configurable type key: INSURANCE, REVENUE_LICENCE, EMISSION, FIRE_SERVICING,
  /// CALIBRATION, WARRANTY, STATUTORY_INSPECTION, SERVICE_AGREEMENT, or custom.
  typeKey         String
  subjectType     String
  subjectId       String
  title           String
  issuedAt        DateTime?
  expiresAt       DateTime?
  gracePeriodDays Int       @default(0)
  reminderDays    Int       @default(30)
  status          String    @default("") @db.NVarChar(64)
  certificateUrl  String?
  providerName    String?
  metadata        String?   @db.NVarChar(Max)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([tenantId, typeKey, status])
  @@index([tenantId, subjectType, subjectId])
  @@index([tenantId, expiresAt])
  @@index([tenantId, isActive, expiresAt])
}

model ChecklistExecution {
  id               String    @id @default(cuid()) @db.NVarChar(36)
  tenantId         String    @db.NVarChar(36)
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  templateId       String    @db.NVarChar(36)
  templateRevision Int
  templateSnapshot String    @db.NVarChar(Max)
  workOrderId      String?   @db.NVarChar(36)
  inspectionId     String?   @db.NVarChar(36)
  executedById     String?   @db.NVarChar(36)
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  answers          String?   @db.NVarChar(Max)
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([tenantId, workOrderId])
  @@index([tenantId, inspectionId])
  @@index([tenantId, templateId])
}

model InspectionFinding {
  id                       String     @id @default(cuid()) @db.NVarChar(36)
  tenantId                 String     @db.NVarChar(36)
  tenant                   Tenant     @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inspectionId             String     @db.NVarChar(36)
  inspection               Inspection @relation(fields: [inspectionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  itemKey                  String?
  severity                 String     @default("MEDIUM")
  description              String
  evidenceUrls             String     @default("[]") @db.NVarChar(Max)
  correctiveActionRequired Boolean    @default(true)
  maintenanceRequestId     String?    @db.NVarChar(36)
  workOrderId              String?    @db.NVarChar(36)
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  @@index([tenantId, inspectionId])
  @@index([tenantId, maintenanceRequestId])
}

/// Frozen WO cost breakdown. Historical totals must not change if live unit costs move.
model WorkOrderCostSnapshot {
  id                  String    @id @default(cuid()) @db.NVarChar(36)
  tenantId            String    @db.NVarChar(36)
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workOrderId         String    @unique @db.NVarChar(36)
  workOrder           WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  partsCost           Decimal   @default(0) @db.Decimal(18, 2)
  internalLabourCost  Decimal   @default(0) @db.Decimal(18, 2)
  externalServiceCost Decimal   @default(0) @db.Decimal(18, 2)
  transportCost       Decimal   @default(0) @db.Decimal(18, 2)
  otherCost           Decimal   @default(0) @db.Decimal(18, 2)
  totalCost           Decimal   @default(0) @db.Decimal(18, 2)
  currency            String    @default("LKR")
  snappedAt           DateTime  @default(now())
  snappedById         String?   @db.NVarChar(36)
  notes               String?
  lineItems           String?   @db.NVarChar(Max)

  @@index([tenantId, snappedAt])
}

model VendorContact {
  id         String   @id @default(cuid()) @db.NVarChar(36)
  tenantId   String   @db.NVarChar(36)
  supplierId String   @db.NVarChar(36)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name       String
  role       String?
  email      String?
  phone      String?
  isPrimary  Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId, supplierId])
}

/// AMC / service contract / repair warranty — MaintainPro maintenance context (not Bileeta finance).
model VendorContract {
  id                      String                @id @default(cuid()) @db.NVarChar(36)
  tenantId                String                @db.NVarChar(36)
  tenant                  Tenant                @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supplierId              String                @db.NVarChar(36)
  supplier                Supplier              @relation(fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contractNo              String
  contractType            String                @default("") @db.NVarChar(64)
  status                  String                @default("") @db.NVarChar(64)
  title                   String
  coverage                String?
  slaSummary              String?
  visitCount              Int?
  contractAssets          VendorContractAsset[]
  contractSites           VendorContractSite[]
  startDate               DateTime
  endDate                 DateTime
  valueReference          Float?
  currency                String                @default("LKR")
  documentUrls            String                @default("[]") @db.NVarChar(Max)
  reminderDays            Int                   @default(30)
  /// Optional bridge to Phase 8 ComplianceRequirement for expiry reminders.
  complianceRequirementId String?               @db.NVarChar(36)
  notes                   String?
  isActive                Boolean               @default(true)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  @@unique([tenantId, contractNo])
  @@index([tenantId, status])
  @@index([tenantId, supplierId])
  @@index([tenantId, endDate])
  @@index([tenantId, complianceRequirementId])
}

/// Repair / warranty coverage linked to a work order (MaintainPro maintenance context).
model RepairWarranty {
  id           String    @id @default(cuid()) @db.NVarChar(36)
  tenantId     String    @db.NVarChar(36)
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workOrderId  String    @db.NVarChar(36)
  workOrder    WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supplierId   String?   @db.NVarChar(36)
  supplier     Supplier? @relation(fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  startDate    DateTime
  endDate      DateTime
  coverage     String?
  reference    String?
  documentUrls String    @default("[]") @db.NVarChar(Max)
  isActive     Boolean   @default(true)
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId, workOrderId])
  @@index([tenantId, endDate])
  @@index([tenantId, supplierId])
}

