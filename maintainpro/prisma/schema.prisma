  documents      String          @default("[]") @db.NVarChar(Max)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([tenantId, claimNumber])
  @@index([tenantId])
  @@index([vehicleId])
  @@index([accidentId])
  @@index([status])
