// ============================================================
// CLEANING MANAGEMENT MODULE
// ============================================================

model CleaningLocation {
  id                      String   @id @default(cuid()) @db.NVarChar(36)
  tenantId                String?  @db.NVarChar(36)
  tenant                  Tenant?  @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name                    String
  area                    String
  building                String?
  floor                   String?
  description             String?
  /// MP-003 (2026-09-17): KEPT GLOBAL — deliberately not tenant-scoped, unlike the other
  /// business keys touched in this migration. Evidence: (1) the value is a cryptographically
  /// random `randomUUID()` (cleaning.service.ts), not a human-entered code, so cross-tenant
  /// collision risk is already negligible; (2) CleaningService.scanVisit() resolves a scanned
  /// physical QR sticker with `findUnique({ where: { qrCode } })` alone — by design, the
  /// scanning device has no tenant context up front, that's the whole point of scanning — and
  /// only AFTER that global lookup does it explicitly re-check
  /// `location.tenantId !== scopedTenantId` and fail closed (commented "Fail-closed: the
  /// scanned location must belong to the cleaner's tenant"). That is: tenant isolation for QR
  /// scanning is intentionally enforced at the application layer, not the uniqueness
  /// constraint. Making qrCode tenant-scoped would break `findUnique({ where: { qrCode } })`
  /// (Prisma would no longer treat it as a unique selector) for no isolation benefit.
  qrCode                  String   @unique
  qrCodeUrl               String?  @db.NVarChar(Max)
  scheduleCron            String?
  shiftWindow             String?
  cleaningFrequency       Int      @default(1)
  cleaningFrequencyUnit   String   @default("") @db.NVarChar(64)
  shiftAssignment         String   @default("") @db.NVarChar(64)
  assignedCleanerId       String?  @db.NVarChar(36)
  assignedCleaner         User?    @relation("AssignedCleaningLocations", fields: [assignedCleanerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  geoLatitude             Float?
  geoLongitude            Float?
  geoRadiusMeters         Int      @default(150)
  requireDeviceValidation Boolean  @default(false)
  requirePhotoEvidence    Boolean  @default(false)
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  visits             CleaningVisit[]
  checklistTemplates CleaningChecklistTemplate[]
  issues             FacilityIssue[]

  @@index([tenantId])
  @@index([isActive])
  @@index([assignedCleanerId])
}

