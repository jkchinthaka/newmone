  notes            String?
  heldAt           DateTime
  expectedResumeAt DateTime?
  resumedAt        DateTime?
  heldById         String?   @db.NVarChar(36)
  resumedById      String?   @db.NVarChar(36)
  durationMinutes  Int?
  createdAt        DateTime  @default(now())

  @@index([tenantId, workOrderId])
  @@index([workOrderId, heldAt])
}

model WorkOrderLabourEntry {
