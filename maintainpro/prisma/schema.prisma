generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid()) @db.NVarChar(36)
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships                  TenantMembership[]
  invitations                  TenantInvitation[]
  userInvitations              UserInvitation[]
  subscriptions                Subscription[]
  usageMetrics                 UsageMetric[]
  usageEvents                  UsageEvent[]
  stripeCustomer               StripeCustomer?
  stripeInvoices               StripeInvoice[]
  users                        User[]
  roles                        Role[]
  assets                       Asset[]
  vehicles                     Vehicle[]
  drivers                      Driver[]
  workOrders                   WorkOrder[]
  workOrderAssignees           WorkOrderAssignee[]
  employeeRosters              EmployeeRosterEntry[]
  employeeLeaveRequests        EmployeeLeaveRequest[]
  spareParts                   SparePart[]
  warehouses                   Warehouse[]
  warehouseItemBalances        WarehouseItemBalance[]
  stockMovements               StockMovement[]
  inventoryIdempotencies       InventoryIdempotency[]
  inventoryImportRuns          InventoryImportRun[]
  bulkImportRuns               BulkImportRun[]
  suppliers                    Supplier[]
  purchaseOrders               PurchaseOrder[]
  partRequests                 PartRequest[]
  partIssues                   PartIssue[]
  partRequestApprovals         PartRequestApproval[]
  workOrderParts               WorkOrderPart[]
  purchaseOrderApprovals       PurchaseOrderApproval[]
  purchaseOrderErpSyncAttempts PurchaseOrderErpSync[]
  purchaseOrderLines           PurchaseOrderLine[]
  purchaseReceipts             PurchaseReceipt[]
  purchaseReceiptLines         PurchaseReceiptLine[]
  purchaseReceiptIdempotencies PurchaseReceiptIdempotency[]
  meters                       UtilityMeter[]
  bills                        UtilityBill[]
  audits                       AuditLog[]
  securityEvents               SecurityEvent[]
  cleaningLocations            CleaningLocation[]
  cleaningVisits               CleaningVisit[]
  facilityIssues               FacilityIssue[]
  properties                   Property[]
  buildings                    Building[]
  floors                       Floor[]
  rooms                        Room[]
  /// Phase 3 authoritative spatial masters (legacy Property/Building/Floor/Room retained)
  sites                        Site[]
  functionalLocations          FunctionalLocation[]
  /// Phase 4 configurable asset taxonomy (tenant-scoped)
  assetDomains                 AssetDomain[]
  assetCategoryMasters         AssetCategoryMaster[]
  assetTypeMasters             AssetTypeMaster[]
  assetAttributeDefinitions    AssetAttributeDefinition[]
  assetLocationHistories       AssetLocationHistory[]
  /// Phase 5 canonical maintenance requests (FacilityIssue retained + bridge)
  maintenanceRequests          MaintenanceRequest[]
  maintenanceRequestHistories  MaintenanceRequestHistory[]
  maintenanceJobCategories     MaintenanceJobCategory[]
  prioritySlaRules             PrioritySlaRule[]
  maintenanceReasonCodes       MaintenanceReasonCode[]
  configChangeHistories        ConfigChangeHistory[]
  tenantFeatureFlags           TenantFeatureFlag[]
  maintenanceTemplates         MaintenanceTemplate[]
  entityWarranties             EntityWarranty[]
  warrantyClaims               WarrantyClaim[]
  downtimeSegments             DowntimeSegment[]
  rcaCases                     RcaCase[]
  capaActions                  CapaAction[]
  workPermits                  WorkPermit[]
  reliabilityPolicies          ReliabilityPolicy[]
  requestProblemCategories     RequestProblemCategory[]
  maintenanceAnalysisCodes     MaintenanceAnalysisCode[]
  workOrderHoldHistories       WorkOrderHoldHistory[]
  workOrderLabourEntries       WorkOrderLabourEntry[]
  workOrderStatusHistories     WorkOrderStatusHistory[]
  /// Phase 7 configurable approval engine (procurement Part/PO approvals remain separate)
  approvalRules                ApprovalRule[]
  approvalRuleLevels           ApprovalRuleLevel[]
  approvalRequests             ApprovalRequest[]
  approvalSteps                ApprovalStep[]
  approvalDecisions            ApprovalDecision[]
  /// Phase 8 planning / meters / inspection / calibration / compliance
  pmPlans                      PmPlan[]
  assetMeters                  AssetMeter[]
  checklistTemplates           ChecklistTemplate[]
  inspectionTemplates          InspectionTemplate[]
  inspections                  Inspection[]
  calibrationRecords           CalibrationRecord[]
  complianceRequirements       ComplianceRequirement[]
  checklistExecutions          ChecklistExecution[]
  inspectionFindings           InspectionFinding[]
  jobCodes                     JobCode[]
  departments                  Department[]
  vehicleDocuments             VehicleDocument[]
  accidentReports              AccidentReport[]
  insuranceClaims              InsuranceClaim[]
  trafficFines                 TrafficFine[]
  refreshTokens                RefreshToken[]
  evidenceAttachments          EvidenceAttachment[]
  employees                    Employee[]
  qaIssues                     QaIssue[]
  deliveryChecklists           DeliveryChecklist[]
  deliverySignOffs             DeliverySignOff[]
  trainingSessions             TrainingSession[]
  supportTickets               SupportTicket[]
  escalationRules              EscalationRule[]
  changeRequests               ChangeRequest[]
  softwareReleases             SoftwareRelease[]
  hypercarePlans               HypercarePlan[]
  supportHandover              SupportHandover?
  pilotRollouts                PilotRollout[]
  cutoverChecklistItems        CutoverChecklistItem[]
  rolloutWaves                 RolloutWave[]
  goLiveDecisions              GoLiveDecision[]
  rollbackPlans                RollbackPlan[]
  goLiveSignOffs               GoLiveSignOff[]
  uatScenarioExecutions        UatScenarioExecution[]
  erpFieldMappings             ErpFieldMapping[]
  erpImportBatches             ErpImportBatch[]
  erpImportRows                ErpImportRow[]
  erpReconciliationMismatches  ErpReconciliationMismatch[]
  erpAccessChecklistItems      ErpAccessChecklistItem[]
  erpMockSyncRuns              ErpMockSyncRun[]
  vendorRepairCases            VendorRepairCase[]
  vendorQuotations             VendorQuotation[]
  vendorInvoices               VendorInvoice[]
  /// Phase 9 — WO cost snapshots, vendor contracts, repair warranties
  workOrderCostSnapshots       WorkOrderCostSnapshot[]
  vendorContracts              VendorContract[]
  repairWarranties             RepairWarranty[]
  workOrderTaxonomies          WorkOrderTaxonomy[]
  businessExceptions           BusinessException[]
  partCompatibilities          PartCompatibility[]
  installedParts               InstalledPart[]
  vehicleHealthSnapshots       VehicleHealthSnapshot[]
  procurementRecommendations   ProcurementRecommendation[]
  maintenanceForecasts         MaintenanceForecast[]
  domainEventOutbox            DomainEventOutbox[]
  budgetCommitments            BudgetCommitment[]
  /// Phase 10 — fleet lifecycle: tyres, batteries, driver assignment history
  vehicleTyres                 VehicleTyre[]
  vehicleBatteries             VehicleBattery[]
  vehicleAssignments           VehicleAssignment[]
}

model AuditLog {
  id            String   @id @default(cuid()) @db.NVarChar(36)
  tenantId      String?  @db.NVarChar(36)
  tenant        Tenant?  @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  entity        String
  entityId      String
  action        String   @db.NVarChar(64)
  module        String?
  reason        String?
  actorId       String?  @db.NVarChar(36)
  actor         User?    @relation(fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ipAddress     String?
  userAgent     String?
  requestPath   String?
  actorSnapshot String?  @db.NVarChar(Max)
  metadata      String?  @db.NVarChar(Max)
  beforeData    String?  @db.NVarChar(Max)
  afterData     String?  @db.NVarChar(Max)
  createdAt     DateTime @default(now())

  @@index([entity, entityId])
  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, module, createdAt])
  @@index([actorId, createdAt])
}

/// Queryable security/ops events (login failures, locks). Never store passwords/tokens.
model SecurityEvent {
  id                    String   @id @default(cuid()) @db.NVarChar(36)
  tenantId              String?  @db.NVarChar(36)
  tenant                Tenant?  @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actorId               String?  @db.NVarChar(36)
  eventType             String
  outcome               String
  requestId             String?
  reasonCode            String?
  sourceCategory        String   @default("AUTH")
  identifierFingerprint String?
  metadata              String?  @db.NVarChar(Max)
  createdAt             DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, eventType, createdAt])
  @@index([eventType, createdAt])
  @@index([requestId])
}

/// Phase 6B durable operational alert state (safe metadata only — no URIs/credentials).
model OperationalAlert {
  id                 String    @id @default(cuid()) @db.NVarChar(36)
  key                String
  fingerprint        String
  severity           String    @db.NVarChar(64)
  status             String    @default("") @db.NVarChar(64)
  source             String
  safeSummary        String
  firstObservedAt    DateTime  @default(now())
  lastObservedAt     DateTime  @default(now())
  occurrenceCount    Int       @default(1)
  acknowledgedAt     DateTime?
  acknowledgedById   String?   @db.NVarChar(36)
  resolvedAt         DateTime?
  resolutionReason   String?
  lastNotificationAt DateTime?
  cooldownUntil      DateTime?
  tenantId           String?   @db.NVarChar(36)
  metadataSafe       String?   @db.NVarChar(Max)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([fingerprint, status])
  @@index([key, status])
  @@index([tenantId, status, lastObservedAt])
  @@index([status, lastObservedAt])
}

model AppSetting {
  id        String   @id @default(cuid()) @db.NVarChar(36)
  scope     String   @default("") @db.NVarChar(64)
  scopeId   String   @default("GLOBAL")
  key       String
  value     String   @db.NVarChar(Max)
  isSecret  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scope, scopeId, key])
  @@index([key])
  @@index([scope, scopeId])
}

model ReplicationOutbox {
  id             String    @id @default(cuid()) @db.NVarChar(36)
  tenantId       String?   @db.NVarChar(36)
  entityType     String
  entityId       String
  operation      String    @db.NVarChar(64)
  payload        String?   @db.NVarChar(Max)
  modelName      String
  status         String    @default("") @db.NVarChar(64)
  attemptCount   Int       @default(0)
  lastError      String?
  nextRetryAt    DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  syncedAt       DateTime?
  sourceDatabase String    @default("primary")
  targetDatabase String    @default("backup")
  correlationId  String
  actorUserId    String?   @db.NVarChar(36)

  @@index([status, nextRetryAt])
  @@index([entityType, entityId])
  @@index([tenantId, status])
  @@index([createdAt])
  @@index([correlationId])
}

model Permission {
  id          String   @id @default(cuid()) @db.NVarChar(36)
  key         String   @unique @db.NVarChar(191)
  description String?  @db.NVarChar(Max)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roleLinks RolePermission[]
}

model User {
  id                         String      @id @default(cuid()) @db.NVarChar(36)
  tenantId                   String?     @db.NVarChar(36)
  tenant                     Tenant?     @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  email                      String      @unique
  passwordHash               String
  firstName                  String
  lastName                   String
  phone                      String?
  avatar                     String?
  roleId                     String      @db.NVarChar(36)
  role                       Role        @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// FK to Department master — nullable for legacy records
  departmentId               String?     @db.NVarChar(36)
  department                 Department? @relation("UserDepartment", fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Job designation for workforce allocation (e.g. Electrician, Fitter)
  designation                String?
  /// Daily capacity in hours for workload checks (default 8)
  dailyCapacityHours         Float       @default(8)
  /// Skill tags — see UserSkill junction (Phase 15)
  /// Force password change on next login (temp password / reset)
  mustChangePassword         Boolean     @default(false)
  /// Optional branch scope label for RBAC filtering
  branchScope                String?
  temporaryPasswordExpiresAt DateTime?
  lastPasswordChangedAt      DateTime?
  isActive                   Boolean     @default(true)
  lastLogin                  DateTime?
  failedLoginAttempts        Int         @default(0)
  lockedUntil                DateTime?
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt

  assignedWorkOrders          WorkOrder[]                 @relation("TechnicianWorkOrders")
  createdWorkOrders           WorkOrder[]                 @relation("CreatorWorkOrders")
  approvedWorkOrders          WorkOrder[]                 @relation("ApprovedWorkOrders")
  verifiedWorkOrders          WorkOrder[]                 @relation("VerifiedWorkOrders")
  reopenedWorkOrders          WorkOrder[]                 @relation("ReopenedWorkOrders")
  qrVerifiedWorkOrders        WorkOrder[]                 @relation("QrVerifiedWorkOrders")
  memberships                 TenantMembership[]
  sentInvitations             TenantInvitation[]          @relation("TenantInvitedBy")
  notifications               Notification[]
  auditEvents                 AuditLog[]
  inventoryImportRuns         InventoryImportRun[]
  bulkImportRuns              BulkImportRun[]
  driverProfile               Driver?
  cleaningVisits              CleaningVisit[]             @relation("CleanerVisits")
  signedOffVisits             CleaningVisit[]             @relation("SupervisorSignOffs")
  assignedCleaningLocations   CleaningLocation[]          @relation("AssignedCleaningLocations")
  reportedIssues              FacilityIssue[]             @relation("ReportedFacilityIssues")
  resolvedIssues              FacilityIssue[]             @relation("ResolvedFacilityIssues")
  assignedFacilityIssues      FacilityIssue[]             @relation("AssignedFacilityIssues")
  copilotConversations        CopilotConversation[]
  copilotMessages             CopilotMessage[]
  copilotExchangeLogs         CopilotExchangeLog[]
  managedDepartments          Department[]                @relation("DepartmentManager")
  recordedVehicleMeterLogs    VehicleMeterLog[]           @relation("VehicleMeterRecordedBy")
  approvedVehicleGateMoves    VehicleGateMovement[]       @relation("VehicleGateApprovedBy")
  partRequestsRequested       PartRequest[]               @relation("PartRequestRequester")
  partRequestApprovals        PartRequestApproval[]       @relation("PartRequestApprovalActor")
  partIssuesIssued            PartIssue[]                 @relation("PartIssueIssuer")
  purchaseOrderApprovals      PurchaseOrderApproval[]     @relation("PurchaseOrderApprovalActor")
  purchaseOrdersCreated       PurchaseOrder[]             @relation("PurchaseOrderCreator")
  purchaseOrderErpSyncActions PurchaseOrderErpSync[]      @relation("PurchaseOrderErpSyncTrigger")
  purchaseReceiptsReceived    PurchaseReceipt[]           @relation("PurchaseReceiptReceiver")
  vehicleDocsUploaded         VehicleDocument[]           @relation("VehicleDocUploader")
  vehicleDocsVerified         VehicleDocument[]           @relation("VehicleDocVerifier")
  accidentsReported           AccidentReport[]            @relation("AccidentReporter")
  accidentEvidenceUploaded    AccidentEvidence[]          @relation("AccidentEvidenceUploader")
  insuranceClaimsFiled        InsuranceClaim[]            @relation("InsuranceClaimFiler")
  trafficFinesReported        TrafficFine[]               @relation("TrafficFineReporter")
  refreshTokens               RefreshToken[]
  passwordResetTokens         PasswordResetToken[]
  userInvitations             UserInvitation[]            @relation("UserInvitationTarget")
  sentUserInvitations         UserInvitation[]            @relation("UserInvitationSender")
  evidenceAttachmentsUploaded EvidenceAttachment[]        @relation("EvidenceUploader")
  workOrderAssignmentsCreated WorkOrderAssignee[]         @relation("WorkOrderAssigneeAssignedBy")
  employeeLeaveApprovals      EmployeeLeaveRequest[]      @relation("EmployeeLeaveApprover")
  linkedWorkforceEmployees    Employee[]                  @relation("EmployeeLinkedUser")
  responsibleAssets           Asset[]                     @relation("AssetResponsiblePerson")
  reportedMaintenanceRequests MaintenanceRequest[]        @relation("ReportedMaintenanceRequests")
  triageOwnedRequests         MaintenanceRequest[]        @relation("TriageOwnerRequests")
  maintenanceRequestHistory   MaintenanceRequestHistory[] @relation("RequestHistoryActor")
  configChangeHistories       ConfigChangeHistory[]       @relation("ConfigChangeActor")
  tenantFeatureFlagsUpdated   TenantFeatureFlag[]         @relation("TenantFeatureFlagUpdatedBy")
  maintenanceTemplatesCreated MaintenanceTemplate[]       @relation("MaintenanceTemplateCreatedBy")
  maintenanceTemplatesUpdated MaintenanceTemplate[]       @relation("MaintenanceTemplateUpdatedBy")
  entityWarrantiesCreated     EntityWarranty[]            @relation("EntityWarrantyCreatedBy")
  warrantyClaimsCreated       WarrantyClaim[]             @relation("WarrantyClaimCreatedBy")
  warrantyClaimsUpdated       WarrantyClaim[]             @relation("WarrantyClaimUpdatedBy")
  downtimeSegmentsOpened      DowntimeSegment[]           @relation("DowntimeOpenedBy")
  downtimeSegmentsClosed      DowntimeSegment[]           @relation("DowntimeClosedBy")
  rcaCasesOwned               RcaCase[]                   @relation("RcaCaseOwner")
  capaActionsOwned            CapaAction[]                @relation("CapaActionOwner")
  workPermitsIssued           WorkPermit[]                @relation("WorkPermitIssuedBy")
  workPermitsApproved         WorkPermit[]                @relation("WorkPermitApprovedBy")
  /// Phase 7 approval engine actors
  approvalRulesCreated        ApprovalRule[]              @relation("ApprovalRuleCreatedBy")
  approvalRulesUpdated        ApprovalRule[]              @relation("ApprovalRuleUpdatedBy")
  approvalRuleLevelUsers      ApprovalRuleLevel[]         @relation("ApprovalRuleLevelUser")
  approvalRuleLevelBackups    ApprovalRuleLevel[]         @relation("ApprovalRuleLevelBackup")
  approvalRequestsRequested   ApprovalRequest[]           @relation("ApprovalRequestRequester")
  approvalStepsAssigned       ApprovalStep[]              @relation("ApprovalStepAssignee")
  approvalStepsBackup         ApprovalStep[]              @relation("ApprovalStepBackup")
  approvalDecisionsActed      ApprovalDecision[]          @relation("ApprovalDecisionActor")
  userSkills                  UserSkill[]

  @@index([tenantId])
  @@index([roleId])
  @@index([departmentId])
  @@index([designation])
}

model RefreshToken {
  id                  String    @id @default(cuid()) @db.NVarChar(36)
  tokenHash           String    @unique
  familyId            String    @default(uuid())
  replacedByTokenHash String?
  userId              String    @db.NVarChar(36)
  user                User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenantId            String?   @db.NVarChar(36)
  tenant              Tenant?   @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  deviceInfo          String?
  ipAddress           String?
  userAgent           String?
  expiresAt           DateTime
  revokedAt           DateTime?
  lastUsedAt          DateTime?
  createdAt           DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([tenantId, createdAt])
  @@index([familyId, createdAt])
  @@index([expiresAt])
  @@index([revokedAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid()) @db.NVarChar(36)
  tokenHash String    @unique
  userId    String    @db.NVarChar(36)
  user      User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  expiresAt DateTime
  usedAt    DateTime?
  ipAddress String?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@index([usedAt])
}

model Role {
  id        String   @id @default(cuid()) @db.NVarChar(36)
  tenantId  String?  @db.NVarChar(36)
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name      String   @db.NVarChar(64)
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissionLinks RolePermission[]

  @@index([tenantId, name])
  @@index([tenantId])
}

model TenantMembership {
  id             String   @id @default(cuid()) @db.NVarChar(36)
  tenantId       String   @db.NVarChar(36)
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId         String   @db.NVarChar(36)
  user           User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  membershipRole String   @default("") @db.NVarChar(64)
  joinedAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId, membershipRole])
}

model TenantInvitation {
  id             String    @id @default(cuid()) @db.NVarChar(36)
  tenantId       String    @db.NVarChar(36)
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  email          String
  firstName      String?
  lastName       String?
  membershipRole String    @default("") @db.NVarChar(64)
  invitedById    String    @db.NVarChar(36)
  invitedBy      User      @relation("TenantInvitedBy", fields: [invitedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  token          String    @unique
  status         String    @default("") @db.NVarChar(64)
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId, email])
  @@index([invitedById])
  @@index([status, expiresAt])
}

/// Login invitation for people onboarding — token stored hashed only.
model UserInvitation {
  id                   String    @id @default(cuid()) @db.NVarChar(36)
  tenantId             String?   @db.NVarChar(36)
  tenant               Tenant?   @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId               String    @db.NVarChar(36)
  user                 User      @relation("UserInvitationTarget", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tokenHash            String    @unique
  expiresAt            DateTime
  acceptedAt           DateTime?
  invitedById          String    @db.NVarChar(36)
  invitedBy            User      @relation("UserInvitationSender", fields: [invitedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status               String    @default("") @db.NVarChar(64)
  lastInvitationSentAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId])
  @@index([tenantId, status])
  @@index([status, expiresAt])
}

model Plan {
  id            String         @id @default(cuid()) @db.NVarChar(36)
  code          String         @unique
  name          String
  description   String?
  isActive      Boolean        @default(true)
  currency      String         @default("USD")
  priceMonthly  Float          @default(0)
  priceYearly   Float          @default(0)
  metadata      String?        @db.NVarChar(Max)
  entitlements  Entitlement[]
  subscriptions Subscription[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Subscription {
  id                   String          @id @default(cuid()) @db.NVarChar(36)
  tenantId             String          @db.NVarChar(36)
  tenant               Tenant          @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  planId               String          @db.NVarChar(36)
  plan                 Plan            @relation(fields: [planId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status               String          @default("") @db.NVarChar(64)
  billingInterval      String          @default("") @db.NVarChar(64)
  seats                Int             @default(5)
  isCurrent            Boolean         @default(true)
  startedAt            DateTime        @default(now())
  currentPeriodStart   DateTime        @default(now())
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean         @default(false)
  canceledAt           DateTime?
  stripeSubscriptionId String?         @unique
  stripePriceId        String?
  invoices             StripeInvoice[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([tenantId, isCurrent])
  @@index([status])
  @@index([planId])
}

model Entitlement {
  id          String   @id @default(cuid()) @db.NVarChar(36)
  planId      String   @db.NVarChar(36)
  plan        Plan     @relation(fields: [planId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  key         String
  type        String   @default("") @db.NVarChar(64)
  enabled     Boolean  @default(true)
  limitValue  Int?
  unit        String?
  overageRate Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([planId, key])
  @@index([key])
}

model UsageMetric {
  id          String   @id @default(cuid()) @db.NVarChar(36)
  tenantId    String   @db.NVarChar(36)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  key         String
  window      String   @default("") @db.NVarChar(64)
  periodStart DateTime
  periodEnd   DateTime
  value       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, key, window, periodStart])
  @@index([tenantId, periodEnd])
}

model UsageEvent {
  id         String   @id @default(cuid()) @db.NVarChar(36)
  tenantId   String   @db.NVarChar(36)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  key        String
  eventType  String   @default("") @db.NVarChar(64)
  quantity   Int      @default(1)
  metadata   String?  @db.NVarChar(Max)
  occurredAt DateTime @default(now())

  @@index([tenantId, key, occurredAt])
}

model StripeCustomer {
  id         String   @id @default(cuid()) @db.NVarChar(36)
  tenantId   String   @unique @db.NVarChar(36)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customerId String   @unique
  email      String?
  name       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model StripeInvoice {
  id               String        @id @default(cuid()) @db.NVarChar(36)
  tenantId         String        @db.NVarChar(36)
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subscriptionId   String?       @db.NVarChar(36)
  subscription     Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  stripeInvoiceId  String        @unique
  invoiceNumber    String?
  amountDue        Float         @default(0)
  amountPaid       Float         @default(0)
  currency         String        @default("usd")
  status           String
  hostedInvoiceUrl String?
  invoicePdf       String?
  dueDate          DateTime?
  paidAt           DateTime?
  periodStart      DateTime?
  periodEnd        DateTime?
  raw              String?       @db.NVarChar(Max)
  createdAt        DateTime      @default(now())

  @@index([tenantId, createdAt])
  @@index([subscriptionId])
}

// ─── Department Master ──────────────────────────────────────────────────────
model Department {
  id          String       @id @default(cuid()) @db.NVarChar(36)
  tenantId    String?      @db.NVarChar(36)
  tenant      Tenant?      @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name        String
  code        String
  description String?
  isActive    Boolean      @default(true)
  /// Self-FK for hierarchical departments (parent org unit)
  parentId    String?      @db.NVarChar(36)
  parent      Department?  @relation("DeptChildren", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    Department[] @relation("DeptChildren")
  /// Optional FK to User who manages this department
  managerId   String?      @db.NVarChar(36)
  manager     User?        @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  assets              Asset[]              @relation("AssetDepartment")
  vehicles            Vehicle[]            @relation("VehicleDepartment")
  drivers             Driver[]             @relation("DriverDepartment")
  users               User[]               @relation("UserDepartment")
  employees           Employee[]           @relation("EmployeeDepartment")
  /// Optional business ownership link for physical locations (not a hierarchy node)
  functionalLocations FunctionalLocation[] @relation("LocationDepartment")
  maintenanceRequests MaintenanceRequest[] @relation("RequestDepartment")
  workOrders          WorkOrder[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@index([tenantId, parentId])
  @@index([managerId])
}

model Asset {
  id               String      @id @default(cuid()) @db.NVarChar(36)
  /// MP-003: required, not optional — every Asset belongs to exactly one tenant (no code
  /// path ever created one with tenantId: null; 0 null-tenant rows found in preflight).
  /// Required so the @@unique([tenantId, assetTag]) below is airtight: SQL Server treats
  /// NULL as never-equal-to-NULL in unique constraints, so a nullable tenantId would let
  /// multiple untenanted rows share the same assetTag without a constraint violation.
  tenantId         String      @db.NVarChar(36)
  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// MP-003: tenant-scoped, not platform-global — see @@unique([tenantId, assetTag]) below.
  /// Bounded: a composite index key of unbounded NVARCHAR(1000) + tenantId would itself risk
  /// the SQL Server 1700-byte nonclustered index key limit (see the Vehicle fields above).
  assetTag         String      @db.NVarChar(64)
  name             String
  description      String?
  /// Legacy fixed enum — retained for compatibility; prefer categoryMasterId
  category         String      @db.NVarChar(64)
  condition        String      @default("") @db.NVarChar(64)
  status           String      @default("") @db.NVarChar(64)
  purchaseDate     DateTime?
  purchasePrice    Float?
  supplier         String?
  /// Legacy free-text department — preserved for historical accuracy
  department       String?
  /// FK to Department master — nullable for legacy records
  departmentId     String?     @db.NVarChar(36)
  departmentRef    Department? @relation("AssetDepartment", fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ownerName        String?
  currentValue     Float?
  /// Deprecated free-text location — keep during Phase 4 migration; authoritative = site/FL
  location         String?
  manufacturer     String?
  model            String?
  serialNumber     String?
  /// Compatibility/summary meter only — Phase 8 owns multi-meter engine
  meterReading     Float?
  /// Compatibility service dates — Phase 8 owns PM plans
  lastServiceDate  DateTime?
  nextServiceDate  DateTime?
  warrantyExpiry   DateTime?
  /// Legacy free-text criticality (SAFETY|PRODUCTION|…); prefer criticalityLevel
  criticality      String?
  criticalityLevel String?     @db.NVarChar(64)
  disposalDate     DateTime?
  disposalReason   String?
  retiredAt        DateTime?
  retirementReason String?
  commissionedAt   DateTime?
  archivedAt       DateTime?
  images           String      @default("[]") @db.NVarChar(Max)
  documents        String      @default("[]") @db.NVarChar(Max)
  /// Data-URI QR images can be several KB of base64; unbounded like the Mongo original.
  qrCodeUrl        String?  @db.NVarChar(Max)

  /// Phase 4 universal registry links
  domainId             String?              @db.NVarChar(36)
  domain               AssetDomain?         @relation(fields: [domainId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categoryMasterId     String?              @db.NVarChar(36)
  categoryMaster       AssetCategoryMaster? @relation(fields: [categoryMasterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  typeMasterId         String?              @db.NVarChar(36)
  typeMaster           AssetTypeMaster?     @relation(fields: [typeMasterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  siteId               String?              @db.NVarChar(36)
  site                 Site?                @relation(fields: [siteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  functionalLocationId String?              @db.NVarChar(36)
  functionalLocation   FunctionalLocation?  @relation(fields: [functionalLocationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parentAssetId        String?              @db.NVarChar(36)
  parentAsset          Asset?               @relation("AssetChildren", fields: [parentAssetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childAssets          Asset[]              @relation("AssetChildren")
  responsiblePersonId  String?              @db.NVarChar(36)
  responsiblePerson    User?                @relation("AssetResponsiblePerson", fields: [responsiblePersonId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Validated type-specific attributes (server validates against AssetAttributeDefinition)
  customAttributes     String?              @db.NVarChar(Max)
  isActive             Boolean              @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  maintenanceLogs      MaintenanceLog[]
  maintenanceSchedules MaintenanceSchedule[]
  workOrders           WorkOrder[]
  predictiveLogs       PredictiveLog[]
  locationHistories    AssetLocationHistory[]
  linkedVehicle        Vehicle?
  maintenanceRequests  MaintenanceRequest[]
  pmPlans              PmPlan[]
  assetMeters          AssetMeter[]
  inspections          Inspection[]
  calibrationRecords   CalibrationRecord[]

  @@unique([tenantId, assetTag])
  @@index([tenantId])
  @@index([status])
  @@index([category])
  @@index([condition])
  @@index([archivedAt])
  @@index([nextServiceDate])
  @@index([departmentId])
  @@index([tenantId, siteId])
  @@index([tenantId, functionalLocationId])
  @@index([tenantId, domainId])
  @@index([tenantId, categoryMasterId])
  @@index([tenantId, typeMasterId])
  @@index([tenantId, parentAssetId])
  @@index([tenantId, criticalityLevel])
  @@index([tenantId, serialNumber])
  @@index([tenantId, isActive])
}

/// Business criticality for maintenance prioritization (do not invent values for legacy rows)
/// Tenant-scoped maintenance domain family (not a separate software engine)
model AssetDomain {
  id          String   @id @default(cuid()) @db.NVarChar(36)
  tenantId    String   @db.NVarChar(36)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  code        String
  name        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  /// Phase 11 tenant overrides for domain profile defaults (merged with static DomainProfileDefaults)
  profile     String?  @db.NVarChar(Max)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categories          AssetCategoryMaster[]
  assets              Asset[]
  maintenanceRequests MaintenanceRequest[]
  workOrders          WorkOrder[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

/// Configurable category under a domain — name avoids collision with enum AssetCategory
model AssetCategoryMaster {
  id          String      @id @default(cuid()) @db.NVarChar(36)
  tenantId    String      @db.NVarChar(36)
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  domainId    String      @db.NVarChar(36)
  domain      AssetDomain @relation(fields: [domainId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  code        String
  name        String
  description String?
  /// Optional deterministic map from legacy AssetCategory enum value
  legacyEnum  String?     @db.NVarChar(64)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  types  AssetTypeMaster[]
  assets Asset[]

  @@unique([tenantId, domainId, code])
  @@index([tenantId, domainId])
  @@index([tenantId, isActive])
}

model AssetTypeMaster {
  id          String              @id @default(cuid()) @db.NVarChar(36)
  tenantId    String              @db.NVarChar(36)
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categoryId  String              @db.NVarChar(36)
  category    AssetCategoryMaster @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  code        String
  name        String
  description String?
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  attributeDefinitions AssetAttributeDefinition[]
  assets               Asset[]

  @@unique([tenantId, categoryId, code])
  @@index([tenantId, categoryId])
  @@index([tenantId, isActive])
}

model AssetAttributeDefinition {
  id           String          @id @default(cuid()) @db.NVarChar(36)
  tenantId     String          @db.NVarChar(36)
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  typeMasterId String          @db.NVarChar(36)
  typeMaster   AssetTypeMaster @relation(fields: [typeMasterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  key          String
  label        String
  dataType     String          @db.NVarChar(64)
  unit         String?
  required     Boolean         @default(false)
  options      String          @default("[]") @db.NVarChar(Max)
  minValue     Float?
  maxValue     Float?
  displayOrder Int             @default(0)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([tenantId, typeMasterId, key])
  @@index([tenantId, typeMasterId, isActive])
}

/// Authoritative asset location movement history — never silent overwrite only
model AssetLocationHistory {
  id                       String   @id @default(cuid()) @db.NVarChar(36)
  tenantId                 String   @db.NVarChar(36)
  tenant                   Tenant   @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assetId                  String   @db.NVarChar(36)
  asset                    Asset    @relation(fields: [assetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fromSiteId               String?  @db.NVarChar(36)
  fromFunctionalLocationId String?  @db.NVarChar(36)
  toSiteId                 String   @db.NVarChar(36)
  toFunctionalLocationId   String   @db.NVarChar(36)
  effectiveAt              DateTime @default(now())
  reason                   String
  movedById                String?  @db.NVarChar(36)
  createdAt                DateTime @default(now())

  @@index([tenantId, assetId, effectiveAt])
  @@index([tenantId, toSiteId])
}

model Vehicle {
  id                        String      @id @default(cuid()) @db.NVarChar(36)
  /// MP-003: required — see Asset.tenantId comment for the same rationale (0 null-tenant
  /// rows in preflight; required for @@unique([tenantId, registrationNo]) to be airtight).
  tenantId                  String      @db.NVarChar(36)
  tenant                    Tenant      @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Bounded to real-world plate lengths (SQL Server nonclustered index keys cap at 1700 bytes;
  /// unbounded nvarchar(1000) here would be 2000 bytes and risk "index entry too long" at insert time).
  /// MP-003: tenant-scoped, not platform-global — see @@unique([tenantId, registrationNo]) below.
  registrationNo            String      @db.NVarChar(64)
  assetTag                  String?     @db.NVarChar(64)
  /// Phase 4: Vehicle becomes Asset extension — optional link; full Fleet in Phase 10
  /// `@unique` is required here by Prisma itself (a one-to-one `@relation` FK must be unique) —
  /// it cannot be dropped. On SQL Server, though, the plain UNIQUE constraint Prisma would normally
  /// generate from this attribute allows only ONE NULL total on a nullable column (unlike
  /// Postgres/Mongo, which allow many), so seeding more than one vehicle without an asset link fails.
  /// Prisma 5 has no syntax for a filtered/partial unique index (prisma/prisma#3387), so migration
  /// 20260916120000_sqlserver_filtered_unique_indexes DROPs the plain constraint Prisma's initial
  /// migration created and replaces it with `CREATE UNIQUE NONCLUSTERED INDEX ... WHERE [assetId]
  /// IS NOT NULL`. If a future `prisma migrate dev` schema diff proposes recreating a plain unique
  /// constraint on this column, discard/edit that generated migration — do not apply it as-is.
  assetId                   String?     @unique @db.NVarChar(36)
  asset                     Asset?      @relation(fields: [assetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  make                      String
  vehicleModel              String
  description               String?
  location                  String?
  year                      Int
  type                      String      @db.NVarChar(64)
  ownershipType             String      @default("") @db.NVarChar(64)
  status                    String      @default("") @db.NVarChar(64)
  serviceStatus             String      @default("") @db.NVarChar(64)
  color                     String?
  /// VINs are 17 chars under ISO 3779 (older/legacy formats can be shorter); 32 leaves slack for
  /// legacy data.
  /// MP-003 (2026-09-17): TENANT-SCOPED, not platform-global. Reverses the 2026-09-16 session's
  /// framing of VIN as "a real-world globally-unique identifier" — that was an assumption about
  /// the physical world, not evidence from this codebase. The only place VIN uniqueness is
  /// actually validated is vehicle-master-import.ts's bulk-import duplicate check, which builds
  /// its "existing VIN" set exclusively from `prisma.vehicle.findMany({ where: { tenantId } })` —
  /// i.e. the application has only ever enforced VIN uniqueness per tenant, never across tenants.
  /// No other code path (no DTO field, no direct CRUD validation) touches VIN at all. Enforced via
  /// a migration-only filtered composite index (Prisma has no partial-unique syntax, prisma#3387):
  /// `CREATE UNIQUE NONCLUSTERED INDEX ... ON Vehicle(tenantId, vin) WHERE vin IS NOT NULL` — see
  /// 20260917120000_mp003_tenant_scoped_business_keys.
  vin                       String?     @db.NVarChar(32)
  engineNo                  String?
  vendorName                String?
  costCenter                String?
  acquisitionDate           DateTime?
  purchasePrice             Float?
  currentValue              Float?
  warrantyExpiry            DateTime?
  fuelType                  String      @db.NVarChar(64)
  fuelCapacity              Float?
  currentMileage            Float       @default(0)
  serviceIntervalDays       Int?
  serviceIntervalMileage    Float?
  insuranceExpiry           DateTime?
  roadTaxExpiry             DateTime?
  complianceStatus          String      @default("") @db.NVarChar(64)
  complianceLastEvaluatedAt DateTime?
  lastServiceDate           DateTime?
  nextServiceDate           DateTime?
  nextServiceMileage        Float?
  decommissionedAt          DateTime?
  decommissionReason        String?
  customFields              String?     @db.NVarChar(Max)
  gpsDeviceId               String?
  images                    String      @default("[]") @db.NVarChar(Max)
  driverId                  String?     @db.NVarChar(36)
  driver                    Driver?     @relation(fields: [driverId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// FK to Department master — nullable for legacy records
  departmentId              String?     @db.NVarChar(36)
  department                Department? @relation("VehicleDepartment", fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Phase 10 — fleet lifecycle gate block flag (backend-authoritative; gate engine is canonical)
  gateBlocked               Boolean     @default(false)
  gateBlockReason           String?
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt

  fuelLogs             FuelLog[]
  tripLogs             TripLog[]
  maintenanceSchedules MaintenanceSchedule[]
  maintenanceLogs      MaintenanceLog[]
  workOrders           WorkOrder[]
  gpsLocations         GpsLocation[]
  meterLogs            VehicleMeterLog[]
  gateMovements        VehicleGateMovement[]
  documents            VehicleDocument[]
  accidents            AccidentReport[]
  insuranceClaims      InsuranceClaim[]
  trafficFines         TrafficFine[]
  installedParts       InstalledPart[]
  healthSnapshots      VehicleHealthSnapshot[]
  pmPlans              PmPlan[]
  assetMeters          AssetMeter[]
  inspections          Inspection[]
  /// Phase 10 — tyres, batteries, and driver assignment history
  tyres                VehicleTyre[]
  batteries            VehicleBattery[]
  assignments          VehicleAssignment[]

  @@unique([tenantId, registrationNo])
  @@index([tenantId])
  @@index([status])
  @@index([driverId])
  @@index([location])
  @@index([type])
  @@index([departmentId])
  @@index([serviceStatus])
  @@index([assetTag])
  @@index([costCenter])
  @@index([tenantId, status, nextServiceDate])
}

/// Phase 10 — tyre lifecycle condition states
/// Phase 10 — VehicleTyre tracks the full lifecycle of each tyre per wheel position.
/// isActive=true means the tyre is currently fitted; false means it has been removed/disposed.
/// Each install creates a new row; moves/rotates deactivate the old row and create a new one.
model VehicleTyre {
  id                String    @id @default(cuid()) @db.NVarChar(36)
  tenantId          String    @db.NVarChar(36)
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vehicleId         String    @db.NVarChar(36)
  vehicle           Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  serialNumber      String?
  brand             String?
  size              String?
  tyreType          String?
  wheelPosition     String?
  installedAt       DateTime?
  installedMileage  Float?
  removedAt         DateTime?
  removedMileage    Float?
  rotatedAt         DateTime?
  retreadCount      Int       @default(0)
  condition         String    @default("") @db.NVarChar(64)
  isActive          Boolean   @default(true)
  costSnapshot      Float?
  warrantyExpiresAt DateTime?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([tenantId, vehicleId])
  @@index([tenantId, serialNumber])
  @@index([tenantId, vehicleId, wheelPosition, isActive])
}

/// Phase 10 — VehicleBattery tracks battery installs with full lifecycle history.
/// Each replace deactivates the previous active battery and creates a new row.
model VehicleBattery {
  id                     String    @id @default(cuid()) @db.NVarChar(36)
  tenantId               String    @db.NVarChar(36)
  tenant                 Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vehicleId              String    @db.NVarChar(36)
  vehicle                Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  serialNumber           String?
  brand                  String?
  model                  String?
  capacityAh             Float?
  installedAt            DateTime?
  removedAt              DateTime?
  warrantyExpiresAt      DateTime?
  condition              String?
  failureReason          String?
  costSnapshot           Float?
  isActive               Boolean   @default(true)
  replacementWorkOrderId String?   @db.NVarChar(36)
  notes                  String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([tenantId, vehicleId])
  @@index([tenantId, serialNumber])
  @@index([tenantId, isActive])
}

/// Phase 10 — VehicleAssignment tracks driver handover history per vehicle.
/// isCurrent=true for the active assignment; closed via returnAssignment.
model VehicleAssignment {
  id                String    @id @default(cuid()) @db.NVarChar(36)
  tenantId          String    @db.NVarChar(36)
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vehicleId         String    @db.NVarChar(36)
  vehicle           Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  driverId          String    @db.NVarChar(36)
  driver            Driver    @relation(fields: [driverId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignedAt        DateTime  @default(now())
  returnedAt        DateTime?
  openingMileage    Float?
  closingMileage    Float?
  fuelLevelStart    Float?
  fuelLevelEnd      Float?
  conditionNotes    String?
  handoverChecklist String?   @db.NVarChar(Max)
  assignedById      String?   @db.NVarChar(36)
  returnedById      String?   @db.NVarChar(36)
  notes             String?
  isCurrent         Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([tenantId, vehicleId])
  @@index([tenantId, driverId])
  @@index([tenantId, isCurrent])
}

model Driver {
  id                        String      @id @default(cuid()) @db.NVarChar(36)
  /// MP-003: required — see Asset.tenantId comment for rationale.
  tenantId                  String      @db.NVarChar(36)
  tenant                    Tenant      @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId                    String      @unique @db.NVarChar(36)
  user                      User        @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// MP-003: tenant-scoped — see @@unique([tenantId, licenseNumber]) below. Bounded for the
  /// same composite-index-key-size reason as Asset.assetTag above.
  licenseNumber             String      @db.NVarChar(64)
  licenseClass              String
  licenseExpiry             DateTime
  isAvailable               Boolean     @default(true)
  trainingStatus            String      @default("") @db.NVarChar(64)
  trainingCompletedAt       DateTime?
  trainingExpiry            DateTime?
  supervisorReviewScore     Int?
  pendingDisciplinaryIssues Int         @default(0)
  /// FK to Department master — nullable for legacy records
  departmentId              String?     @db.NVarChar(36)
  department                Department? @relation("DriverDepartment", fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt

  vehicles           Vehicle[]
  fuelLogs           FuelLog[]
  tripLogs           TripLog[]
  gateMovements      VehicleGateMovement[]
  accidents          AccidentReport[]
  trafficFines       TrafficFine[]
  /// Phase 10 — driver assignment history
  vehicleAssignments VehicleAssignment[]

  @@unique([tenantId, licenseNumber])
  @@index([tenantId])
  @@index([departmentId])
}

model FuelLog {
  id             String   @id @default(cuid()) @db.NVarChar(36)
  vehicleId      String   @db.NVarChar(36)
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  driverId       String?  @db.NVarChar(36)
  driver         Driver?  @relation(fields: [driverId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  date           DateTime
  liters         Float
  costPerLiter   Decimal  @db.Decimal(18, 2)
  totalCost      Decimal  @db.Decimal(18, 2)
  mileageAtFuel  Float
  fuelStation    String?
  receiptUrl     String?
  notes          String?
  clientActionId String?
  createdAt      DateTime @default(now())

  @@index([vehicleId, date])
  @@index([driverId, date])
  @@index([vehicleId, clientActionId])
}

model TripLog {
  id            String    @id @default(cuid()) @db.NVarChar(36)
  vehicleId     String    @db.NVarChar(36)
  vehicle       Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  driverId      String    @db.NVarChar(36)
  driver        Driver    @relation(fields: [driverId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  startLocation String
  endLocation   String
  startMileage  Float
  endMileage    Float
  distance      Float
  startTime     DateTime
  endTime       DateTime?
  purpose       String?
  status        String    @default("") @db.NVarChar(64)
  notes         String?
  createdAt     DateTime  @default(now())

  @@index([vehicleId, startTime])
  @@index([driverId, startTime])
}

model VehicleMeterLog {
  id           String   @id @default(cuid()) @db.NVarChar(36)
  vehicleId    String   @db.NVarChar(36)
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recordedById String?  @db.NVarChar(36)
