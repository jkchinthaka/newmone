model AccidentReport {
  id                  String   @id @default(cuid()) @db.NVarChar(36)
  /// MP-003: required — see Asset.tenantId comment for rationale.
  tenantId            String   @db.NVarChar(36)
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// MP-003: tenant-scoped — see @@unique([tenantId, reportNumber]) below.
  reportNumber        String   @db.NVarChar(64)
  vehicleId           String   @db.NVarChar(36)
  vehicle             Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  driverId            String?  @db.NVarChar(36)
  driver              Driver?  @relation(fields: [driverId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reportedById        String   @db.NVarChar(36)
  reportedBy          User     @relation("AccidentReporter", fields: [reportedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  occurredAt          DateTime
  location            String
  description         String
  severity            String   @default("") @db.NVarChar(64)
  status              String   @default("") @db.NVarChar(64)
  responsibility      String   @default("") @db.NVarChar(64)
  thirdPartyInvolved  Boolean  @default(false)
  thirdPartyDetails   String?
  policeReportNo      String?
  estimatedDamageCost Float?
  actualDamageCost    Float?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  evidence        AccidentEvidence[]
  workOrders      WorkOrder[]
  insuranceClaims InsuranceClaim[]

  @@unique([tenantId, reportNumber])
  @@index([tenantId])
  @@index([vehicleId])
  @@index([driverId])
  @@index([occurredAt])
  @@index([status])
  @@index([responsibility])
}

