  tenant                 Tenant?          @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  locationId             String           @db.NVarChar(36)
  location               CleaningLocation @relation(fields: [locationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cleanerId              String           @db.NVarChar(36)
  cleaner                User             @relation("CleanerVisits", fields: [cleanerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  scannedAt              DateTime         @default(now())
  clientScannedAt        DateTime?
  startedAt              DateTime?
  method                 String           @default("") @db.NVarChar(64)
  deviceId               String?
  completedAt            DateTime?
  durationSeconds        Int?
  latitude               Float?
  longitude              Float?
  geofenceDistanceMeters Float?
  geoValidated           Boolean          @default(false)
  beforePhotos           String           @default("[]") @db.NVarChar(Max)
  afterPhotos            String           @default("[]") @db.NVarChar(Max)
  checklistScore         Int?
  photoScore             Int?
  qualityScore           Int?
  scheduleStatus         String           @default("") @db.NVarChar(64)
  status                 String           @default("") @db.NVarChar(64)
  notes                  String?
  signedOffById          String?          @db.NVarChar(36)
  signedOffBy            User?            @relation("SupervisorSignOffs", fields: [signedOffById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  signedOffAt            DateTime?
  signOffNotes           String?
  supervisorRating       Int?
  supervisorComment      String?
  rejectionReason        String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  checklist CleaningChecklist?

  @@index([tenantId])
  @@index([locationId, scannedAt])
  @@index([cleanerId, scannedAt])
  @@index([status])
  @@index([scheduleStatus])
}

model CleaningChecklist {
  id          String        @id @default(cuid()) @db.NVarChar(36)
  visitId     String        @unique @db.NVarChar(36)
  visit       CleaningVisit @relation(fields: [visitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items       String        @db.NVarChar(Max)
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// ============================================================
// PHASE 5 — Canonical Maintenance Request & Triage
// FacilityIssue remains for cleaning/facility history; MR is company-wide.
// ============================================================

/// Tenant-scoped symptom/problem categories (not Phase 6 failure/cause/remedy codes)
model RequestProblemCategory {
  id          String   @id @default(cuid()) @db.NVarChar(36)
  tenantId    String   @db.NVarChar(36)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  code        String
  name        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requests MaintenanceRequest[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

model MaintenanceRequest {
  id                String  @id @default(cuid()) @db.NVarChar(36)
  tenantId          String  @db.NVarChar(36)
  tenant            Tenant  @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requestNumber     String
  status            String  @default("") @db.NVarChar(64)
  /// Reuse WorkOrder Priority enum — avoid parallel priority enums
  priority          String  @default("") @db.NVarChar(64)
  requestedPriority String? @db.NVarChar(64)

  reportedById     String    @db.NVarChar(36)
  reportedBy       User      @relation("ReportedMaintenanceRequests", fields: [reportedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reportedAt       DateTime  @default(now())
  failureNoticedAt DateTime?

  assetId              String?             @db.NVarChar(36)
  asset                Asset?              @relation(fields: [assetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  siteId               String?             @db.NVarChar(36)
  site                 Site?               @relation(fields: [siteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  functionalLocationId String?             @db.NVarChar(36)
  functionalLocation   FunctionalLocation? @relation(fields: [functionalLocationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  departmentId         String?             @db.NVarChar(36)
  department           Department?         @relation("RequestDepartment", fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  domainId             String?             @db.NVarChar(36)
  domain               AssetDomain?        @relation(fields: [domainId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// MACHINERY | SERVICE | VEHICLE — inherited by converted work orders
  jobDomain            String?             @db.NVarChar(32)

  problemCategoryId    String?                 @db.NVarChar(36)
  problemCategory      RequestProblemCategory? @relation(fields: [problemCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Free-text category label when master not yet selected
  problemCategoryLabel String?
  description          String
  affectsOperation     Boolean                 @default(false)
  businessImpact       String?
  isEmergency          Boolean                 @default(false)

  /// Server-built report-time context — immutable after create (asset may move later)
  contextSnapshot String? @db.NVarChar(Max)

  triageNotes      String?
  publicUpdateNote String?
  triageOwnerId    String?   @db.NVarChar(36)
  triageOwner      User?     @relation("TriageOwnerRequests", fields: [triageOwnerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reviewedAt       DateTime?
  approvedAt       DateTime?
  rejectedAt       DateTime?
  cancelledAt      DateTime?
  convertedAt      DateTime?

  rejectionReasonType String? @db.NVarChar(64)
  rejectionReason     String?
  cancellationReason  String?

  /// Duplicate of another request (same open event) — not the same as repeat failure
  duplicateOfId String?              @db.NVarChar(36)
  duplicateOf   MaintenanceRequest?  @relation("RequestDuplicates", fields: [duplicateOfId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  duplicates    MaintenanceRequest[] @relation("RequestDuplicates")

  relatedRequestId String?              @db.NVarChar(36)
  relatedRequest   MaintenanceRequest?  @relation("RelatedRequests", fields: [relatedRequestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  relatedFrom      MaintenanceRequest[] @relation("RelatedRequests")

  /// Idempotent conversion: at most one primary WO
  workOrderId String?    @unique @db.NVarChar(36)
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// Client idempotency for offline/PWA create retries
  idempotencyKey String?

  /// Bridge from FacilityIssue (do not delete FacilityIssue in Phase 5)
  legacySourceType String?
  legacySourceId   String?

  history             MaintenanceRequestHistory[]
  evidenceAttachments EvidenceAttachment[]
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  @@unique([tenantId, requestNumber])
  @@index([tenantId, idempotencyKey])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, siteId, status])
  @@index([tenantId, assetId, status])
  @@index([tenantId, functionalLocationId, status])
  @@index([tenantId, priority, status])
  @@index([tenantId, reportedById, createdAt])
  @@index([tenantId, domainId])
  @@index([tenantId, jobDomain])
  @@index([tenantId, duplicateOfId])
  @@index([tenantId, legacySourceType, legacySourceId])
}

/// Admin-configurable main/sub job categories by operational job domain.
model MaintenanceJobCategory {
  id        String                  @id @default(cuid()) @db.NVarChar(36)
  tenantId  String                  @db.NVarChar(36)
  tenant    Tenant                  @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// MACHINERY | SERVICE | VEHICLE
  jobDomain String                  @db.NVarChar(32)
  /// MAIN | SUB
  level     String                  @db.NVarChar(16)
  parentId  String?                 @db.NVarChar(36)
  parent    MaintenanceJobCategory? @relation("JobCategoryTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  MaintenanceJobCategory[] @relation("JobCategoryTree")
  code      String                  @db.NVarChar(64)
  name      String                  @db.NVarChar(200)
  active    Boolean                 @default(true)
  sortOrder Int                     @default(0)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  @@unique([tenantId, jobDomain, code])
  @@index([tenantId, jobDomain, level, active])
  @@index([tenantId, parentId])
}

/// Admin-configurable priority response / completion targets (minutes).
model PrioritySlaRule {
  id                 String   @id @default(cuid()) @db.NVarChar(36)
  tenantId           String   @db.NVarChar(36)
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  priority           String   @db.NVarChar(32)
  responseMinutes    Int?
  completionMinutes  Int?
  escalateOnBreach   Boolean  @default(true)
  notifyOnBreach     Boolean  @default(true)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([tenantId, priority])
  @@index([tenantId, active])
}

/// Admin-configurable hold / delay reason codes (replaces hardcoded-only lists).
model MaintenanceReasonCode {
  id          String   @id @default(cuid()) @db.NVarChar(36)
  tenantId    String   @db.NVarChar(36)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// HOLD | DELAY
  kind        String   @db.NVarChar(16)
  code        String   @db.NVarChar(64)
  name        String   @db.NVarChar(200)
  description String?
  requiresNotes Boolean @default(false)
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, kind, code])
  @@index([tenantId, kind, active])
}

/// Append-only history for Admin master-data and policy configuration changes.
model ConfigChangeHistory {
  id           String   @id @default(cuid()) @db.NVarChar(36)
  tenantId     String   @db.NVarChar(36)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// e.g. PrioritySlaRule, MaintenanceJobCategory, MaintenanceAnalysisCode
  entityType   String   @db.NVarChar(64)
  entityId     String   @db.NVarChar(36)
  action       String   @db.NVarChar(32)
  reason       String?
  beforeJson   String?  @db.NVarChar(Max)
  afterJson    String?  @db.NVarChar(Max)
  version      Int      @default(1)
  actorId      String?  @db.NVarChar(36)
  actor        User?    @relation("ConfigChangeActor", fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt    DateTime @default(now())

  @@index([tenantId, entityType, entityId, createdAt])
  @@index([tenantId, createdAt])
}

/// Tenant-scoped module/feature switches. UI may hide modules; backend still enforces.
model TenantFeatureFlag {
  id            String    @id @default(cuid()) @db.NVarChar(36)
  tenantId      String    @db.NVarChar(36)
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  code          String    @db.NVarChar(64)
  name          String    @db.NVarChar(200)
  description   String?
  enabled       Boolean   @default(true)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  /// Safe typed JSON payload only — never executable scripts
  configJson    String?   @db.NVarChar(Max)
  updatedById   String?   @db.NVarChar(36)
  updatedBy     User?     @relation("TenantFeatureFlagUpdatedBy", fields: [updatedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, enabled])
}

/// Versioned reusable maintenance work template (not the same as ChecklistTemplate).
model MaintenanceTemplate {
  id                    String    @id @default(cuid()) @db.NVarChar(36)
  tenantId              String    @db.NVarChar(36)
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  code                  String    @db.NVarChar(64)
  name                  String    @db.NVarChar(200)
  description           String?
  /// MACHINERY | SERVICE | VEHICLE
  jobDomain             String    @db.NVarChar(32)
  jobType               String?   @db.NVarChar(64)
  categoryCode          String?   @db.NVarChar(64)
  subcategoryCode       String?   @db.NVarChar(64)
  defaultPriority       String    @default("MEDIUM") @db.NVarChar(32)
  estimatedHours        Float?
  estimatedDowntimeMin  Int?
  defaultExecutionMode  String?   @db.NVarChar(32)
  requiredSkillsJson    String    @default("[]") @db.NVarChar(Max)
  defaultPartsJson      String    @default("[]") @db.NVarChar(Max)
  safetyRequirementsJson String   @default("[]") @db.NVarChar(Max)
  permitRequirement     String?   @db.NVarChar(64)
  checklistTemplateId   String?   @db.NVarChar(36)
  checklistTemplate     ChecklistTemplate? @relation(fields: [checklistTemplateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  signOffRequirementsJson String  @default("[]") @db.NVarChar(Max)
  instructions          String?   @db.NVarChar(Max)
  documentsJson         String    @default("[]") @db.NVarChar(Max)
  version               Int       @default(1)
  effectiveFrom         DateTime  @default(now())
  effectiveTo           DateTime?
  active                Boolean   @default(true)
  createdById           String?   @db.NVarChar(36)
  createdBy             User?     @relation("MaintenanceTemplateCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedById           String?   @db.NVarChar(36)
  updatedBy             User?     @relation("MaintenanceTemplateUpdatedBy", fields: [updatedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  workOrders            WorkOrder[]

  @@unique([tenantId, code, version])
  @@index([tenantId, jobDomain, active])
  @@index([tenantId, code, active])
}

/// Warranty covering an asset, vehicle, part, tyre, battery, or vendor repair subject.
model EntityWarranty {
  id              String    @id @default(cuid()) @db.NVarChar(36)
  tenantId        String    @db.NVarChar(36)
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// ASSET | VEHICLE | MACHINE | TYRE | BATTERY | SPARE_PART | SERIALIZED_COMPONENT | VENDOR_REPAIR
  subjectType     String    @db.NVarChar(32)
  subjectId       String    @db.NVarChar(36)
  provider        String    @db.NVarChar(200)
  reference       String?   @db.NVarChar(128)
  coverageType    String?   @db.NVarChar(64)
  coverageNotes   String?   @db.NVarChar(Max)
  startDate       DateTime
  endDate         DateTime
  mileageLimit    Int?
  hourLimit       Float?
  documentUrlsJson String   @default("[]") @db.NVarChar(Max)
  /// ACTIVE | EXPIRED | VOID | CLAIMED
  status          String    @default("ACTIVE") @db.NVarChar(32)
  /// WARN | APPROVAL_REQUIRED | RESTRICT_EXTERNAL | VENDOR_RETURN
  policyAction    String    @default("WARN") @db.NVarChar(32)
  createdById     String?   @db.NVarChar(36)
  createdBy       User?     @relation("EntityWarrantyCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  claims          WarrantyClaim[]

  @@index([tenantId, subjectType, subjectId])
  @@index([tenantId, status, endDate])
  @@index([tenantId, endDate])
}

/// Warranty claim / recovery workflow.
model WarrantyClaim {
  id               String         @id @default(cuid()) @db.NVarChar(36)
  tenantId         String         @db.NVarChar(36)
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warrantyId       String         @db.NVarChar(36)
  warranty         EntityWarranty @relation(fields: [warrantyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workOrderId      String?        @db.NVarChar(36)
  workOrder        WorkOrder?     @relation(fields: [workOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  claimNumber      String         @db.NVarChar(64)
  /// ELIGIBLE | PREPARED | SUBMITTED | ACCEPTED | REJECTED | RECOVERED | CLOSED
  status           String         @default("ELIGIBLE") @db.NVarChar(32)
  claimAmount      Decimal?       @db.Decimal(18, 2)
  approvedAmount   Decimal?       @db.Decimal(18, 2)
  recoveredAmount  Decimal?       @db.Decimal(18, 2)
  currency         String         @default("LKR") @db.NVarChar(8)
  submittedAt      DateTime?
  responseAt       DateTime?
  documentUrlsJson String         @default("[]") @db.NVarChar(Max)
  notes            String?        @db.NVarChar(Max)
  createdById      String?        @db.NVarChar(36)
  createdBy        User?          @relation("WarrantyClaimCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedById      String?        @db.NVarChar(36)
  updatedBy        User?          @relation("WarrantyClaimUpdatedBy", fields: [updatedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([tenantId, claimNumber])
  @@index([tenantId, status])
  @@index([tenantId, warrantyId])
  @@index([tenantId, workOrderId])
}

/// Multiple downtime periods per work order (active repair vs waiting parts/vendor/etc.).
model DowntimeSegment {
  id                   String    @id @default(cuid()) @db.NVarChar(36)
  tenantId             String    @db.NVarChar(36)
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workOrderId          String    @db.NVarChar(36)
  workOrder            WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assetId              String?   @db.NVarChar(36)
  /// ACTIVE_REPAIR | WAITING_PARTS | WAITING_VENDOR | WAITING_APPROVAL | WAITING_TECHNICIAN | AWAITING_SHUTDOWN | TESTING | OPERATIONAL_DELAY | OTHER
  category             String    @db.NVarChar(32)
  planned              Boolean   @default(false)
  reasonCode           String?   @db.NVarChar(64)
  reasonNotes          String?
  startedAt            DateTime
  endedAt              DateTime?
  productionAffected   Boolean   @default(false)
  estimatedLostHours   Float?
  estimatedLostUnits   Float?
  openedById           String?   @db.NVarChar(36)
  openedBy             User?     @relation("DowntimeOpenedBy", fields: [openedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  closedById           String?   @db.NVarChar(36)
  closedBy             User?     @relation("DowntimeClosedBy", fields: [closedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([tenantId, workOrderId, startedAt])
  @@index([tenantId, assetId, startedAt])
  @@index([tenantId, category, endedAt])
}

/// Root Cause Analysis case — does not auto-blame people/vendors.
model RcaCase {
  id                String    @id @default(cuid()) @db.NVarChar(36)
  tenantId          String    @db.NVarChar(36)
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workOrderId       String?   @db.NVarChar(36)
  workOrder         WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assetId           String?   @db.NVarChar(36)
  vehicleId         String?   @db.NVarChar(36)
  /// OPEN | IN_REVIEW | COMPLETED | CLOSED
  status            String    @default("OPEN") @db.NVarChar(32)
  problemStatement  String    @db.NVarChar(Max)
  evidenceJson      String    @default("[]") @db.NVarChar(Max)
  fiveWhyJson       String    @default("[]") @db.NVarChar(Max)
  failureCode       String?   @db.NVarChar(64)
  causeCode         String?   @db.NVarChar(64)
  rootCause         String?   @db.NVarChar(Max)
  repeatCandidate   Boolean   @default(false)
  repeatWindowDays  Int?
  similarWoCount    Int       @default(0)
  ownerId           String?   @db.NVarChar(36)
  owner             User?     @relation("RcaCaseOwner", fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  capaActions       CapaAction[]

  @@index([tenantId, status])
  @@index([tenantId, workOrderId])
  @@index([tenantId, assetId, createdAt])
  @@index([tenantId, repeatCandidate])
}

/// Corrective / Preventive Action linked to an RCA.
model CapaAction {
  id               String   @id @default(cuid()) @db.NVarChar(36)
  tenantId         String   @db.NVarChar(36)
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rcaCaseId        String   @db.NVarChar(36)
  rcaCase          RcaCase  @relation(fields: [rcaCaseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// CORRECTIVE | PREVENTIVE
  kind             String   @db.NVarChar(16)
  description      String   @db.NVarChar(Max)
  /// OPEN | IN_PROGRESS | VERIFIED | CLOSED | CANCELLED
  status           String   @default("OPEN") @db.NVarChar(32)
  ownerId          String?  @db.NVarChar(36)
  owner            User?    @relation("CapaActionOwner", fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dueDate          DateTime?
  verifiedAt       DateTime?
  verificationNote String?
  closedAt         DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tenantId, rcaCaseId])
  @@index([tenantId, status, dueDate])
}

/// Permit-to-Work linked to a work order (admin-configurable types).
model WorkPermit {
  id            String    @id @default(cuid()) @db.NVarChar(36)
  tenantId      String    @db.NVarChar(36)
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workOrderId   String    @db.NVarChar(36)
  workOrder     WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  permitNumber  String    @db.NVarChar(64)
  /// ELECTRICAL | HOT_WORK | CONFINED_SPACE | WORKING_AT_HEIGHT | HIGH_RISK_MACHINERY | OTHER
  permitType    String    @db.NVarChar(32)
  /// DRAFT | APPROVED | ACTIVE | SUSPENDED | CLOSED | EXPIRED
  status        String    @default("DRAFT") @db.NVarChar(32)
  hazardsJson   String    @default("[]") @db.NVarChar(Max)
  ppeJson       String    @default("[]") @db.NVarChar(Max)
  validFrom     DateTime?
  validTo       DateTime?
  issuedById    String?   @db.NVarChar(36)
  issuedBy      User?     @relation("WorkPermitIssuedBy", fields: [issuedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approvedById  String?   @db.NVarChar(36)
  approvedBy    User?     @relation("WorkPermitApprovedBy", fields: [approvedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([tenantId, permitNumber])
  @@index([tenantId, workOrderId, status])
  @@index([tenantId, permitType, status])
  @@index([tenantId, validTo])
}

/// Tenant reliability / safety start-gate policy (Admin configurable).
model ReliabilityPolicy {
  id                              String   @id @default(cuid()) @db.NVarChar(36)
  tenantId                        String   @unique @db.NVarChar(36)
  tenant                          Tenant   @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  repeatWindowDays                Int      @default(90)
  matchSameFaultCode              Boolean  @default(true)
  matchSameAsset                  Boolean  @default(true)
  requireRcaOnRepeat              Boolean  @default(false)
  /// When true, WO start is blocked unless an ACTIVE/APPROVED non-expired permit exists for critical assets
  requirePermitForCriticalAssets  Boolean  @default(true)
  /// CSV of Asset.criticalityLevel values that require a permit before start
  permitRequiredCriticalities     String   @default("CRITICAL,HIGH") @db.NVarChar(128)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt
}

model MaintenanceRequestHistory {
  id         String             @id @default(cuid()) @db.NVarChar(36)
  tenantId   String             @db.NVarChar(36)
