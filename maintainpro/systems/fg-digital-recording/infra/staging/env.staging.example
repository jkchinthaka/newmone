# Staging environment variable list — NO SECRETS.
# Copy to a private file outside git and fill from vault.

DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=REPLACE_FROM_VAULT
DJANGO_ALLOWED_HOSTS=fg-staging.nelna.lk
DJANGO_CSRF_TRUSTED_ORIGINS=https://fg-staging.nelna.lk
ENVIRONMENT_LABEL=staging
LOG_LEVEL=INFO

# Prefer STAGING_POSTGRES_DB when using compose.staging.yaml with a local .env present.
STAGING_POSTGRES_DB=nelna_fg_staging
POSTGRES_DB=nelna_fg_staging
POSTGRES_USER=REPLACE_FROM_VAULT
POSTGRES_PASSWORD=REPLACE_FROM_VAULT
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# EMAIL — EXTERNAL BLOCKER if SMTP required and credentials absent
# EMAIL_HOST=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

BILEETA_LIVE_ENABLED=False
BILEETA_BASE_URL=
